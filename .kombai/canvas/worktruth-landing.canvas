      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap'); @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"min-h-screen overflow-x-clip bg-[#f8f8f4] font-sans text-[#171b18] antialiased [--paper:#f8f8f4] [--ink:#171b18] [--muted:#666e67] [--line:#dedfd9] [--green:#286144] [--green-soft:#e8efe8] [--white:#fffefa]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:Geist,Arial,sans-serif\">\n    <header class=\"mx-auto max-w-[1240px] px-8 max-md:px-5\" data-kid=\"1-1\" data-name=\"site header wrapper\">\n        <div class=\"flex h-[78px] items-center justify-between border-b border-[#dedfd9]\" data-kid=\"1-1-1\" data-name=\"header navigation bar\">\n            <a aria-label=\"Worktruth home\" class=\"flex items-center gap-2.5 text-[20px] font-semibold tracking-[-0.7px] text-[#171b18] no-underline\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"/\">\n                <span class=\"flex size-8 items-center justify-center rounded-[9px] bg-[#286144] text-[16px] font-semibold text-white\" data-kid=\"1-1-1-1-1\" data-name=\"brand logomark w. badge\">\n                    w.\n                </span>\n                Worktruth\n            </a>\n            <nav aria-label=\"Main navigation\" class=\"flex items-center gap-8 text-[14px] text-[#4d554e] max-md:hidden\" data-kid=\"1-1-1-2\" data-name=\"desktop main navigation\">\n                <a class=\"no-underline hover:text-[#286144] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#286144]\" data-kid=\"1-1-1-2-1\" data-name=\"nav link explore companies\" href=\"/companies\">\n                    Explore Companies\n                </a>\n                <a class=\"no-underline hover:text-[#286144] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#286144]\" data-kid=\"1-1-1-2-2\" data-name=\"nav link how it works\" href=\"#how-it-works\">\n                    How It Works\n                </a>\n                <a class=\"no-underline hover:text-[#286144] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#286144]\" data-kid=\"1-1-1-2-3\" data-name=\"nav link community guidelines\" href=\"/community-guidelines\">\n                    Community Guidelines\n                </a>\n            </nav>\n            <a class=\"inline-flex h-10 items-center justify-center rounded-[7px] bg-[#286144] px-4 text-[13px] font-medium text-white no-underline hover:bg-[#1f4e35] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#286144] max-md:hidden\" data-kid=\"1-1-1-3\" data-name=\"primary call-to-action write a review\" href=\"/write-review\">\n                Write a Review\n                <span aria-hidden=\"true\" class=\"ml-2 text-[16px]\" data-kid=\"1-1-1-3-1\" data-name=\"external link arrow icon\">\n                    ↗\n                </span>\n            </a>\n            <details class=\"relative hidden max-md:block\" data-kid=\"1-1-1-4\" data-name=\"mobile menu disclosure widget\">\n                <summary aria-label=\"Open navigation menu\" class=\"flex size-10 cursor-pointer list-none items-center justify-center rounded-md border border-[#dedfd9] text-[20px] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#286144]\" data-kid=\"1-1-1-4-1\" data-name=\"mobile menu toggle button\">\n                    <i aria-hidden=\"true\" class=\"icon-menu\" data-kid=\"1-1-1-4-1-1\" data-name=\"menu hamburger icon\">\n                    </i>\n                </summary>\n                <nav aria-label=\"Mobile navigation\" class=\"absolute right-0 top-12 z-10 flex min-w-[230px] flex-col gap-1 rounded-lg border border-[#dedfd9] bg-[#fffefa] p-2 text-[14px] shadow-lg\" data-kid=\"1-1-1-4-2\" data-name=\"mobile dropdown navigation\">\n                    <a class=\"rounded px-3 py-2.5 text-[#171b18] no-underline hover:bg-[#f1f2ec]\" data-kid=\"1-1-1-4-2-1\" data-name=\"mobile nav link explore companies\" href=\"/companies\">\n                        Explore Companies\n                    </a>\n                    <a class=\"rounded px-3 py-2.5 text-[#171b18] no-underline hover:bg-[#f1f2ec]\" data-kid=\"1-1-1-4-2-2\" data-name=\"mobile nav link how it works\" href=\"#how-it-works\">\n                        How It Works\n                    </a>\n                    <a class=\"rounded px-3 py-2.5 text-[#171b18] no-underline hover:bg-[#f1f2ec]\" data-kid=\"1-1-1-4-2-3\" data-name=\"mobile nav link community guidelines\" href=\"/community-guidelines\">\n                        Community Guidelines\n                    </a>\n                    <a class=\"rounded bg-[#286144] px-3 py-2.5 font-medium text-white no-underline\" data-kid=\"1-1-1-4-2-4\" data-name=\"mobile nav call-to-action write a review\" href=\"/write-review\">\n                        Write a Review\n                    </a>\n                </nav>\n            </details>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content region\">\n        <section aria-labelledby=\"hero-title\" class=\"mx-auto grid max-w-[1240px] grid-cols-[1.02fr_.98fr] items-center gap-16 px-8 pb-[82px] pt-[77px] max-lg:gap-10 max-md:grid-cols-1 max-md:gap-12 max-md:px-5 max-md:pb-14 max-md:pt-12\" data-kid=\"1-2-1\" data-name=\"hero section with search and sample review\">\n            <div class=\"max-w-[560px]\" data-kid=\"1-2-1-1\" data-name=\"hero left column with headline and search\">\n                <p class=\"mb-5 text-[13px] font-medium tracking-[0.01em] text-[#536056]\" data-kid=\"1-2-1-1-1\" data-name=\"hero eyebrow label\">\n                    A clearer view of work in Nigerian tech\n                </p>\n                <h1 class=\"max-w-[590px] text-[56px] font-medium leading-[1.07] tracking-[-2.8px] text-[#171b18] max-md:text-[42px] max-md:leading-[1.1] max-md:tracking-[-1.9px]\" data-kid=\"1-2-1-1-2\" data-name=\"hero headline\" id=\"hero-title\">\n                    Know what it’s really like to work there.\n                </h1>\n                <p class=\"mt-6 max-w-[510px] text-[17px] leading-[1.7] text-[#5d655e] max-md:text-[16px]\" data-kid=\"1-2-1-1-3\" data-name=\"hero supporting description\">\n                    Honest workplace experiences from people who have been there. Research Nigerian tech companies before you make your next career move.\n                </p>\n                <form action=\"/companies\" class=\"mt-8 flex min-h-[58px] max-w-[530px] items-center rounded-[8px] border border-[#c9cec7] bg-[#fffefa] p-1.5 shadow-[0_2px_8px_rgba(27,40,29,0.04)] focus-within:border-[#286144] focus-within:ring-2 focus-within:ring-[#286144]/15\" data-kid=\"1-2-1-1-4\" data-name=\"company search form\" method=\"get\">\n                    <label class=\"sr-only\" data-kid=\"1-2-1-1-4-1\" data-name=\"search field screen-reader label\" for=\"company-search\">\n                        Search companies in Nigeria\n                    </label>\n                    <i aria-hidden=\"true\" class=\"icon-search ml-3 text-[18px] text-[#647067]\" data-kid=\"1-2-1-1-4-2\" data-name=\"search magnifier icon\">\n                    </i>\n                    <input class=\"min-w-0 grow border-0 bg-transparent px-3 py-3 text-[14px] text-[#171b18] outline-none placeholder:text-[#858c85]\" data-kid=\"1-2-1-1-4-3\" data-name=\"company search input field\" id=\"company-search\" name=\"q\" placeholder=\"Search companies in Nigeria...\" type=\"search\"/>\n                    <button class=\"inline-flex h-[43px] shrink-0 items-center justify-center gap-2 rounded-[6px] bg-[#286144] px-4 text-[13px] font-medium text-white hover:bg-[#1f4e35] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#286144] max-[430px]:px-3\" data-kid=\"1-2-1-1-4-4\" data-name=\"search submit button\" type=\"submit\">\n                        Search\n                        <span aria-hidden=\"true\" class=\"text-[17px]\" data-kid=\"1-2-1-1-4-4-1\" data-name=\"search button arrow icon\">\n                            ↗\n                        </span>\n                    </button>\n                </form>\n                <div class=\"mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-[13px]\" data-kid=\"1-2-1-1-5\" data-name=\"hero secondary actions row\">\n                    <a class=\"font-medium text-[#286144] underline decoration-[#9bb6a0] underline-offset-4 hover:text-[#1f4e35] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#286144]\" data-kid=\"1-2-1-1-5-1\" data-name=\"share your experience link\" href=\"/write-review\">\n                        Share Your Experience\n                        <span aria-hidden=\"true\" data-kid=\"1-2-1-1-5-1-1\" data-name=\"link arrow icon\">\n                            ↗\n                        </span>\n                    </a>\n                    <span class=\"text-[#727a73]\" data-kid=\"1-2-1-1-5-2\" data-name=\"anonymity reassurance text\">\n                        Read anonymously. Share without an account.\n                    </span>\n                </div>\n            </div>\n            <article aria-labelledby=\"sample-review-heading\" class=\"mx-auto w-full max-w-[525px] border border-[#d9ddd5] bg-[#fffefa] px-7 py-6 shadow-[0_10px_30px_rgba(31,46,33,0.045)] max-md:px-5\" data-kid=\"1-2-1-2\" data-name=\"sample review preview card\">\n                <div class=\"flex flex-wrap items-start justify-between gap-3 border-b border-[#e3e5df] pb-5\" data-kid=\"1-2-1-2-1\" data-name=\"sample review header row\">\n                    <div data-kid=\"1-2-1-2-1-1\" data-name=\"sample review identity block\">\n                        <p class=\"text-[12px] font-medium text-[#286144]\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"example disclaimer label\">\n                            Fictional example · Sample review copy\n                        </p>\n                        <h2 class=\"mt-2 text-[22px] font-semibold tracking-[-0.7px]\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"sample review company title\" id=\"sample-review-heading\">\n                            Fictional: Baobab Circuit\n                        </h2>\n                        <p class=\"mt-1 text-[13px] text-[#727a73]\" data-kid=\"1-2-1-2-1-1-3\" data-name=\"sample review company meta\">\n                            Illustrative software company · Lagos\n                        </p>\n                    </div>\n                    <div class=\"text-right\" data-kid=\"1-2-1-2-1-2\" data-name=\"sample review rating block\">\n                        <div class=\"flex items-center justify-end gap-1.5 text-[18px] font-semibold\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"star rating with score\">\n                            <span class=\"text-[#a87932]\" data-kid=\"1-2-1-2-1-2-1-1\" data-name=\"star icon\">\n                                ★\n                            </span>\n                            4.1\n                        </div>\n                        <p class=\"mt-1 text-[12px] text-[#727a73]\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"review count caption\">\n                            from 8 sample reviews\n                        </p>\n                    </div>\n                </div>\n                <div class=\"pt-5\" data-kid=\"1-2-1-2-2\" data-name=\"sample review body\">\n                    <div class=\"flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1\" data-kid=\"1-2-1-2-2-1\" data-name=\"reviewer role and status row\">\n                        <h3 class=\"text-[15px] font-semibold\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"reviewer role title\">\n                            Product designer\n                        </h3>\n                        <p class=\"text-[12px] text-[#727a73]\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"reviewer status caption\">\n                            Former employee · Fictional review\n                        </p>\n                    </div>\n                    <p class=\"mt-3 text-[14px] leading-[1.7] text-[#454d46]\" data-kid=\"1-2-1-2-2-2\" data-name=\"review quote text\">\n                        “I had room to shape features early, and the team made time for thoughtful design critiques. Priorities could shift mid-sprint, so I learned to ask for trade-offs sooner.”\n                    </p>\n                    <div class=\"mt-5 grid grid-cols-2 gap-6 border-t border-[#e3e5df] pt-4 max-sm:grid-cols-1 max-sm:gap-4\" data-kid=\"1-2-1-2-2-3\" data-name=\"pros and cons grid\">\n                        <div data-kid=\"1-2-1-2-2-3-1\" data-name=\"pros column container\">\n                            <h4 class=\"text-[12px] font-semibold uppercase tracking-[0.09em] text-[#286144]\" data-kid=\"1-2-1-2-2-3-1-1\" data-name=\"pros heading\">\n                                Pros\n                            </h4>\n                            <p class=\"mt-2 text-[13px] leading-[1.65] text-[#454d46]\" data-kid=\"1-2-1-2-2-3-1-2\" data-name=\"pros description\">\n                                Room to own product details; peer feedback was considered.\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-1-2-2-3-2\" data-name=\"cons column container\">\n                            <h4 class=\"text-[12px] font-semibold uppercase tracking-[0.09em] text-[#737970]\" data-kid=\"1-2-1-2-2-3-2-1\" data-name=\"cons heading\">\n                                Cons\n                            </h4>\n                            <p class=\"mt-2 text-[13px] leading-[1.65] text-[#454d46]\" data-kid=\"1-2-1-2-2-3-2-2\" data-name=\"cons description\">\n                                Scope changed quickly; sprint priorities were not always clear.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </article>\n        </section>\n        <section aria-labelledby=\"context-title\" class=\"border-y border-[#e2e3dd] bg-[#f2f3ed]\" data-kid=\"1-2-2\" data-name=\"value proposition section\">\n            <div class=\"mx-auto max-w-[1240px] px-8 py-[66px] max-md:px-5 max-md:py-12\" data-kid=\"1-2-2-1\" data-name=\"value proposition inner container\">\n                <h2 class=\"max-w-[650px] text-[34px] font-medium leading-[1.2] tracking-[-1.3px] max-md:text-[29px]\" data-kid=\"1-2-2-1-1\" data-name=\"value proposition headline\" id=\"context-title\">\n                    Make career decisions with more context.\n                </h2>\n                <div class=\"mt-9 grid grid-cols-3 gap-0 border-y border-[#d9ddd5] max-md:grid-cols-1\" data-kid=\"1-2-2-1-2\" data-name=\"feature value card grid\">\n                    <article class=\"py-6 pr-8 max-md:border-b max-md:border-[#d9ddd5] max-md:pr-0\" data-kid=\"1-2-2-1-2-1\" data-name=\"feature card real experiences\">\n                        <i aria-hidden=\"true\" class=\"icon-messages-square text-[22px] text-[#286144]\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"messages square icon\">\n                        </i>\n                        <h3 class=\"mt-4 text-[16px] font-semibold\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"feature card title real experiences\">\n                            Real Workplace Experiences\n                        </h3>\n                        <p class=\"mt-2 max-w-[310px] text-[14px] leading-[1.65] text-[#626b63]\" data-kid=\"1-2-2-1-2-1-3\" data-name=\"feature card description\">\n                            Learn from current and former employees who can share what a working day feels like.\n                        </p>\n                    </article>\n                    <article class=\"border-l border-[#d9ddd5] px-8 py-6 max-md:border-b max-md:border-l-0 max-md:border-[#d9ddd5] max-md:px-0\" data-kid=\"1-2-2-1-2-2\" data-name=\"feature card anonymous by design\">\n                        <i aria-hidden=\"true\" class=\"icon-eye-off text-[22px] text-[#286144]\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"eye off icon\">\n                        </i>\n                        <h3 class=\"mt-4 text-[16px] font-semibold\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"feature card title anonymous by design\">\n                            Anonymous by Design\n                        </h3>\n                        <p class=\"mt-2 max-w-[310px] text-[14px] leading-[1.65] text-[#626b63]\" data-kid=\"1-2-2-1-2-2-3\" data-name=\"feature card description\">\n                            Share without creating an account. Your identity is not displayed on public reviews.\n                        </p>\n                    </article>\n                    <article class=\"border-l border-[#d9ddd5] py-6 pl-8 max-md:border-l-0 max-md:pl-0\" data-kid=\"1-2-2-1-2-3\" data-name=\"feature card human reviewed feedback\">\n                        <i aria-hidden=\"true\" class=\"icon-clipboard-check text-[22px] text-[#286144]\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"clipboard check icon\">\n                        </i>\n                        <h3 class=\"mt-4 text-[16px] font-semibold\" data-kid=\"1-2-2-1-2-3-2\" data-name=\"feature card title human reviewed feedback\">\n                            Human-Reviewed Feedback\n                        </h3>\n                        <p class=\"mt-2 max-w-[310px] text-[14px] leading-[1.65] text-[#626b63]\" data-kid=\"1-2-2-1-2-3-3\" data-name=\"feature card description\">\n                            Every review is moderated by a person before publication.\n                        </p>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"steps-title\" class=\"mx-auto max-w-[1240px] px-8 py-[76px] max-md:px-5 max-md:py-14\" data-kid=\"1-2-3\" data-name=\"how it works section\" id=\"how-it-works\">\n            <div class=\"max-w-[670px]\" data-kid=\"1-2-3-1\" data-name=\"how it works intro block\">\n                <h2 class=\"text-[34px] font-medium tracking-[-1.3px] max-md:text-[29px]\" data-kid=\"1-2-3-1-1\" data-name=\"how it works headline\" id=\"steps-title\">\n                    A little context goes a long way.\n                </h2>\n                <p class=\"mt-3 text-[15px] leading-[1.65] text-[#626b63]\" data-kid=\"1-2-3-1-2\" data-name=\"how it works description\">\n                    Start with the company on your mind. Leave with a fuller picture.\n                </p>\n            </div>\n            <ol class=\"mt-9 grid grid-cols-3 border-t border-[#d9ddd5] max-md:grid-cols-1 max-md:border-t-0\" data-kid=\"1-2-3-2\" data-name=\"how it works steps list\">\n                <li class=\"relative border-r border-[#d9ddd5] py-6 pr-9 max-md:border-r-0 max-md:border-b max-md:py-5 max-md:pr-0\" data-kid=\"1-2-3-2-1\" data-name=\"step one find a company\">\n                    <span class=\"flex size-8 items-center justify-center rounded-full border border-[#b7c6b9] text-[13px] font-medium text-[#286144]\" data-kid=\"1-2-3-2-1-1\" data-name=\"step number badge 1\">\n                        1\n                    </span>\n                    <h3 class=\"mt-4 text-[17px] font-semibold\" data-kid=\"1-2-3-2-1-2\" data-name=\"step title find a company\">\n                        Find a company.\n                    </h3>\n                    <p class=\"mt-2 max-w-[290px] text-[14px] leading-[1.65] text-[#626b63]\" data-kid=\"1-2-3-2-1-3\" data-name=\"step description\">\n                        Search the Nigerian tech companies you’re considering.\n                    </p>\n                </li>\n                <li class=\"border-r border-[#d9ddd5] px-9 py-6 max-md:border-r-0 max-md:border-b max-md:px-0 max-md:py-5\" data-kid=\"1-2-3-2-2\" data-name=\"step two read employee experiences\">\n                    <span class=\"flex size-8 items-center justify-center rounded-full border border-[#b7c6b9] text-[13px] font-medium text-[#286144]\" data-kid=\"1-2-3-2-2-1\" data-name=\"step number badge 2\">\n                        2\n                    </span>\n                    <h3 class=\"mt-4 text-[17px] font-semibold\" data-kid=\"1-2-3-2-2-2\" data-name=\"step title read employee experiences\">\n                        Read employee experiences.\n                    </h3>\n                    <p class=\"mt-2 max-w-[290px] text-[14px] leading-[1.65] text-[#626b63]\" data-kid=\"1-2-3-2-2-3\" data-name=\"step description\">\n                        Look beyond the score at the details people share.\n                    </p>\n                </li>\n                <li class=\"py-6 pl-9 max-md:py-5 max-md:pl-0\" data-kid=\"1-2-3-2-3\" data-name=\"step three share your experience\">\n                    <span class=\"flex size-8 items-center justify-center rounded-full border border-[#b7c6b9] text-[13px] font-medium text-[#286144]\" data-kid=\"1-2-3-2-3-1\" data-name=\"step number badge 3\">\n                        3\n                    </span>\n                    <h3 class=\"mt-4 text-[17px] font-semibold\" data-kid=\"1-2-3-2-3-2\" data-name=\"step title share your experience\">\n                        Share your own experience anonymously.\n                    </h3>\n                    <p class=\"mt-2 max-w-[290px] text-[14px] leading-[1.65] text-[#626b63]\" data-kid=\"1-2-3-2-3-3\" data-name=\"step description\">\n                        Add thoughtful context without creating an account.\n                    </p>\n                </li>\n            </ol>\n        </section>\n        <section aria-labelledby=\"companies-title\" class=\"border-y border-[#e2e3dd] bg-[#f2f3ed]\" data-kid=\"1-2-4\" data-name=\"companies showcase section\">\n            <div class=\"mx-auto max-w-[1240px] px-8 py-[73px] max-md:px-5 max-md:py-12\" data-kid=\"1-2-4-1\" data-name=\"companies inner container\">\n                <div class=\"flex items-end justify-between gap-8 max-md:flex-col max-md:items-start max-md:gap-4\" data-kid=\"1-2-4-1-1\" data-name=\"companies section header row\">\n                    <div data-kid=\"1-2-4-1-1-1\" data-name=\"companies title block\">\n                        <h2 class=\"max-w-[690px] text-[34px] font-medium leading-[1.2] tracking-[-1.3px] max-md:text-[29px]\" data-kid=\"1-2-4-1-1-1-1\" data-name=\"companies section headline\" id=\"companies-title\">\n                            Get to know the companies behind the job titles.\n                        </h2>\n                        <p class=\"mt-3 text-[13px] text-[#687168]\" data-kid=\"1-2-4-1-1-1-2\" data-name=\"companies disclaimer text\">\n                            All companies and ratings below are fictional demo data.\n                        </p>\n                    </div>\n                    <a class=\"shrink-0 text-[14px] font-medium text-[#286144] underline decoration-[#9bb6a0] underline-offset-4 hover:text-[#1f4e35] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#286144]\" data-kid=\"1-2-4-1-1-2\" data-name=\"explore companies link\" href=\"/companies\">\n                        Explore Companies\n                        <span aria-hidden=\"true\" data-kid=\"1-2-4-1-1-2-1\" data-name=\"link arrow icon\">\n                            ↗\n                        </span>\n                    </a>\n                </div>\n                <div class=\"mt-8 grid grid-cols-4 gap-3 max-lg:grid-cols-2 max-sm:grid-cols-1\" data-kid=\"1-2-4-1-2\" data-name=\"company cards grid\">\n                    <a class=\"group flex min-h-[194px] flex-col border border-[#d9ddd5] bg-[#fffefa] p-5 text-inherit no-underline hover:border-[#9cae9d] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#286144]\" data-kid=\"1-2-4-1-2-1\" data-name=\"company card baobab circuit\" href=\"/companies/baobab-circuit\">\n                        <span class=\"text-[11px] font-medium text-[#286144]\" data-kid=\"1-2-4-1-2-1-1\" data-name=\"fictional sample label\">\n                            FICTIONAL SAMPLE\n                        </span>\n                        <h3 class=\"mt-3 text-[17px] font-semibold tracking-[-0.3px]\" data-kid=\"1-2-4-1-2-1-2\" data-name=\"company card title baobab circuit\">\n                            Baobab Circuit\n                        </h3>\n                        <p class=\"mt-1 text-[12px] text-[#737970]\" data-kid=\"1-2-4-1-2-1-3\" data-name=\"company meta software lagos\">\n                            Software · Lagos\n                        </p>\n                        <div class=\"mt-5 flex items-baseline gap-2\" data-kid=\"1-2-4-1-2-1-4\" data-name=\"company rating row\">\n                            <span class=\"text-[19px] font-semibold\" data-kid=\"1-2-4-1-2-1-4-1\" data-name=\"company rating score\">\n                                4.1\n                            </span>\n                            <span class=\"text-[13px] text-[#a87932]\" data-kid=\"1-2-4-1-2-1-4-2\" data-name=\"star icon\">\n                                ★\n                            </span>\n                            <span class=\"text-[12px] text-[#737970]\" data-kid=\"1-2-4-1-2-1-4-3\" data-name=\"review count caption\">\n                                8 sample reviews\n                            </span>\n                        </div>\n                        <p class=\"mt-2 text-[13px] leading-[1.5] text-[#626b63]\" data-kid=\"1-2-4-1-2-1-5\" data-name=\"company summary blurb\">\n                            Room to own work; priorities can shift.\n                        </p>\n                    </a>\n                    <a class=\"group flex min-h-[194px] flex-col border border-[#d9ddd5] bg-[#fffefa] p-5 text-inherit no-underline hover:border-[#9cae9d] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#286144]\" data-kid=\"1-2-4-1-2-2\" data-name=\"company card lagoon ledger\" href=\"/companies/lagoon-ledger\">\n                        <span class=\"text-[11px] font-medium text-[#286144]\" data-kid=\"1-2-4-1-2-2-1\" data-name=\"fictional sample label\">\n                            FICTIONAL SAMPLE\n                        </span>\n                        <h3 class=\"mt-3 text-[17px] font-semibold tracking-[-0.3px]\" data-kid=\"1-2-4-1-2-2-2\" data-name=\"company card title lagoon ledger\">\n                            Lagoon Ledger\n                        </h3>\n                        <p class=\"mt-1 text-[12px] text-[#737970]\" data-kid=\"1-2-4-1-2-2-3\" data-name=\"company meta fintech abuja\">\n                            Fintech · Abuja\n                        </p>\n                        <div class=\"mt-5 flex items-baseline gap-2\" data-kid=\"1-2-4-1-2-2-4\" data-name=\"company rating row\">\n                            <span class=\"text-[19px] font-semibold\" data-kid=\"1-2-4-1-2-2-4-1\" data-name=\"company rating score\">\n                                3.7\n                            </span>\n                            <span class=\"text-[13px] text-[#a87932]\" data-kid=\"1-2-4-1-2-2-4-2\" data-name=\"star icon\">\n                                ★\n                            </span>\n                            <span class=\"text-[12px] text-[#737970]\" data-kid=\"1-2-4-1-2-2-4-3\" data-name=\"review count caption\">\n                                5 sample reviews\n                            </span>\n                        </div>\n                        <p class=\"mt-2 text-[13px] leading-[1.5] text-[#626b63]\" data-kid=\"1-2-4-1-2-2-5\" data-name=\"company summary blurb\">\n                            Strong mentorship; busy release periods.\n                        </p>\n                    </a>\n                    <a class=\"group flex min-h-[194px] flex-col border border-[#d9ddd5] bg-[#fffefa] p-5 text-inherit no-underline hover:border-[#9cae9d] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#286144]\" data-kid=\"1-2-4-1-2-3\" data-name=\"company card orbit yard\" href=\"/companies/orbit-yard\">\n                        <span class=\"text-[11px] font-medium text-[#286144]\" data-kid=\"1-2-4-1-2-3-1\" data-name=\"fictional sample label\">\n                            FICTIONAL SAMPLE\n                        </span>\n                        <h3 class=\"mt-3 text-[17px] font-semibold tracking-[-0.3px]\" data-kid=\"1-2-4-1-2-3-2\" data-name=\"company card title orbit yard\">\n                            Orbit Yard\n                        </h3>\n                        <p class=\"mt-1 text-[12px] text-[#737970]\" data-kid=\"1-2-4-1-2-3-3\" data-name=\"company meta developer tools lagos\">\n                            Developer tools · Lagos\n                        </p>\n                        <div class=\"mt-5 flex items-baseline gap-2\" data-kid=\"1-2-4-1-2-3-4\" data-name=\"company rating row\">\n                            <span class=\"text-[19px] font-semibold\" data-kid=\"1-2-4-1-2-3-4-1\" data-name=\"company rating score\">\n                                4.4\n                            </span>\n                            <span class=\"text-[13px] text-[#a87932]\" data-kid=\"1-2-4-1-2-3-4-2\" data-name=\"star icon\">\n                                ★\n                            </span>\n                            <span class=\"text-[12px] text-[#737970]\" data-kid=\"1-2-4-1-2-3-4-3\" data-name=\"review count caption\">\n                                3 sample reviews\n                            </span>\n                        </div>\n                        <p class=\"mt-2 text-[13px] leading-[1.5] text-[#626b63]\" data-kid=\"1-2-4-1-2-3-5\" data-name=\"company summary blurb\">\n                            Thoughtful reviews; clear ownership.\n                        </p>\n                    </a>\n                    <a class=\"group flex min-h-[194px] flex-col border border-[#d9ddd5] bg-[#fffefa] p-5 text-inherit no-underline hover:border-[#9cae9d] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#286144]\" data-kid=\"1-2-4-1-2-4\" data-name=\"company card market fern\" href=\"/companies/market-fern\">\n                        <span class=\"text-[11px] font-medium text-[#286144]\" data-kid=\"1-2-4-1-2-4-1\" data-name=\"fictional sample label\">\n                            FICTIONAL SAMPLE\n                        </span>\n                        <h3 class=\"mt-3 text-[17px] font-semibold tracking-[-0.3px]\" data-kid=\"1-2-4-1-2-4-2\" data-name=\"company card title market fern\">\n                            Market Fern\n                        </h3>\n                        <p class=\"mt-1 text-[12px] text-[#737970]\" data-kid=\"1-2-4-1-2-4-3\" data-name=\"company meta commerce ibadan\">\n                            Commerce · Ibadan\n                        </p>\n                        <div class=\"mt-5\" data-kid=\"1-2-4-1-2-4-4\" data-name=\"no reviews placeholder row\">\n                            <span class=\"text-[13px] font-medium text-[#525a53]\" data-kid=\"1-2-4-1-2-4-4-1\" data-name=\"no published reviews text\">\n                                No published reviews\n                            </span>\n                        </div>\n                        <p class=\"mt-2 text-[13px] leading-[1.5] text-[#626b63]\" data-kid=\"1-2-4-1-2-4-5\" data-name=\"company summary blurb\">\n                            Be the first to share a sample experience.\n                        </p>\n                    </a>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"reviews-title\" class=\"mx-auto max-w-[1240px] px-8 py-[76px] max-md:px-5 max-md:py-14\" data-kid=\"1-2-5\" data-name=\"sample reviews section\">\n            <div class=\"flex items-end justify-between gap-8 max-md:flex-col max-md:items-start max-md:gap-3\" data-kid=\"1-2-5-1\" data-name=\"sample reviews header row\">\n                <div data-kid=\"1-2-5-1-1\" data-name=\"sample reviews title block\">\n                    <h2 class=\"max-w-[710px] text-[34px] font-medium leading-[1.2] tracking-[-1.3px] max-md:text-[29px]\" data-kid=\"1-2-5-1-1-1\" data-name=\"sample reviews headline\" id=\"reviews-title\">\n                        More than a rating. Real workplace context.\n                    </h2>\n                    <p class=\"mt-3 text-[14px] text-[#687168]\" data-kid=\"1-2-5-1-1-2\" data-name=\"sample reviews intro text\">\n                        Fictional sample reviews, written to demonstrate the kind of detail that helps.\n                    </p>\n                </div>\n                <a class=\"text-[13px] font-medium text-[#286144] underline decoration-[#9bb6a0] underline-offset-4 hover:text-[#1f4e35]\" data-kid=\"1-2-5-1-2\" data-name=\"browse all companies link\" href=\"/companies\">\n                    Browse all companies ↗\n                </a>\n            </div>\n            <div class=\"mt-8 grid grid-cols-2 gap-4 max-md:grid-cols-1\" data-kid=\"1-2-5-2\" data-name=\"sample review cards grid\">\n                <article class=\"border border-[#d9ddd5] bg-[#fffefa] p-6 max-md:p-5\" data-kid=\"1-2-5-2-1\" data-name=\"review card baobab circuit\">\n                    <div class=\"flex flex-wrap items-start justify-between gap-4 border-b border-[#e3e5df] pb-4\" data-kid=\"1-2-5-2-1-1\" data-name=\"review card header\">\n                        <div data-kid=\"1-2-5-2-1-1-1\" data-name=\"review identity block\">\n                            <p class=\"text-[11px] font-medium text-[#286144]\" data-kid=\"1-2-5-2-1-1-1-1\" data-name=\"review category label\">\n                                FICTIONAL SAMPLE REVIEW\n                            </p>\n                            <h3 class=\"mt-2 text-[17px] font-semibold\" data-kid=\"1-2-5-2-1-1-1-2\" data-name=\"review company title\">\n                                Fictional: Baobab Circuit\n                            </h3>\n                            <p class=\"mt-1 text-[13px] text-[#727a73]\" data-kid=\"1-2-5-2-1-1-1-3\" data-name=\"reviewer role and status caption\">\n                                Product designer · Former employee\n                            </p>\n                        </div>\n                        <div class=\"text-right\" data-kid=\"1-2-5-2-1-1-2\" data-name=\"review rating block\">\n                            <p class=\"text-[19px] font-semibold\" data-kid=\"1-2-5-2-1-1-2-1\" data-name=\"review rating with star\">\n                                4.1\n                                <span class=\"text-[14px] text-[#a87932]\" data-kid=\"1-2-5-2-1-1-2-1-1\" data-name=\"star icon\">\n                                    ★\n                                </span>\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-[#727a73]\" data-kid=\"1-2-5-2-1-1-2-2\" data-name=\"overall rating label\">\n                                Overall rating\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"mt-4 grid grid-cols-2 gap-5 max-sm:grid-cols-1 max-sm:gap-3\" data-kid=\"1-2-5-2-1-2\" data-name=\"review pros and cons grid\">\n                        <div data-kid=\"1-2-5-2-1-2-1\" data-name=\"review pros column\">\n                            <h4 class=\"text-[12px] font-semibold text-[#286144]\" data-kid=\"1-2-5-2-1-2-1-1\" data-name=\"review pros heading\">\n                                Pros\n                            </h4>\n                            <p class=\"mt-1.5 text-[13px] leading-[1.6] text-[#525a53]\" data-kid=\"1-2-5-2-1-2-1-2\" data-name=\"review pros quote\">\n                                “I had room to shape features early. Peers shared thoughtful design feedback and made time to explain the why behind decisions.”\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-5-2-1-2-2\" data-name=\"review cons column\">\n                            <h4 class=\"text-[12px] font-semibold text-[#737970]\" data-kid=\"1-2-5-2-1-2-2-1\" data-name=\"review cons heading\">\n                                Cons\n                            </h4>\n                            <p class=\"mt-1.5 text-[13px] leading-[1.6] text-[#525a53]\" data-kid=\"1-2-5-2-1-2-2-2\" data-name=\"review cons quote\">\n                                “Scope could change during a sprint, so I learned to clarify the trade-offs before committing to a deadline.”\n                            </p>\n                        </div>\n                    </div>\n                    <p class=\"mt-5 border-t border-[#e3e5df] pt-3 text-[12px] text-[#737970]\" data-kid=\"1-2-5-2-1-3\" data-name=\"review footer date and label\">\n                        Published · 14 Aug 2024\n                        <span class=\"px-1.5\" data-kid=\"1-2-5-2-1-3-1\" data-name=\"footer separator dot\">\n                            ·\n                        </span>\n                        Fictional example\n                    </p>\n                </article>\n                <article class=\"border border-[#d9ddd5] bg-[#fffefa] p-6 max-md:p-5\" data-kid=\"1-2-5-2-2\" data-name=\"review card lagoon ledger\">\n                    <div class=\"flex flex-wrap items-start justify-between gap-4 border-b border-[#e3e5df] pb-4\" data-kid=\"1-2-5-2-2-1\" data-name=\"review card header\">\n                        <div data-kid=\"1-2-5-2-2-1-1\" data-name=\"review identity block\">\n                            <p class=\"text-[11px] font-medium text-[#286144]\" data-kid=\"1-2-5-2-2-1-1-1\" data-name=\"review category label\">\n                                FICTIONAL SAMPLE REVIEW\n                            </p>\n                            <h3 class=\"mt-2 text-[17px] font-semibold\" data-kid=\"1-2-5-2-2-1-1-2\" data-name=\"review company title\">\n                                Fictional: Lagoon Ledger\n                            </h3>\n                            <p class=\"mt-1 text-[13px] text-[#727a73]\" data-kid=\"1-2-5-2-2-1-1-3\" data-name=\"reviewer role and status caption\">\n                                Customer support lead · Current employee\n                            </p>\n                        </div>\n                        <div class=\"text-right\" data-kid=\"1-2-5-2-2-1-2\" data-name=\"review rating block\">\n                            <p class=\"text-[19px] font-semibold\" data-kid=\"1-2-5-2-2-1-2-1\" data-name=\"review rating with star\">\n                                3.2\n                                <span class=\"text-[14px] text-[#a87932]\" data-kid=\"1-2-5-2-2-1-2-1-1\" data-name=\"star icon\">\n                                    ★\n                                </span>\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-[#727a73]\" data-kid=\"1-2-5-2-2-1-2-2\" data-name=\"overall rating label\">\n                                Overall rating\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"mt-4 grid grid-cols-2 gap-5 max-sm:grid-cols-1 max-sm:gap-3\" data-kid=\"1-2-5-2-2-2\" data-name=\"review pros and cons grid\">\n                        <div data-kid=\"1-2-5-2-2-2-1\" data-name=\"review pros column\">\n                            <h4 class=\"text-[12px] font-semibold text-[#286144]\" data-kid=\"1-2-5-2-2-2-1-1\" data-name=\"review pros heading\">\n                                Pros\n                            </h4>\n                            <p class=\"mt-1.5 text-[13px] leading-[1.6] text-[#525a53]\" data-kid=\"1-2-5-2-2-2-1-2\" data-name=\"review pros quote\">\n                                “My manager backed the team when we raised customer issues. New starters were paired with an experienced teammate.”\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-5-2-2-2-2\" data-name=\"review cons column\">\n                            <h4 class=\"text-[12px] font-semibold text-[#737970]\" data-kid=\"1-2-5-2-2-2-2-1\" data-name=\"review cons heading\">\n                                Cons\n                            </h4>\n                            <p class=\"mt-1.5 text-[13px] leading-[1.6] text-[#525a53]\" data-kid=\"1-2-5-2-2-2-2-2\" data-name=\"review cons quote\">\n                                “Release weeks could run long, and promotion expectations were not always written down.”\n                            </p>\n                        </div>\n                    </div>\n                    <p class=\"mt-5 border-t border-[#e3e5df] pt-3 text-[12px] text-[#737970]\" data-kid=\"1-2-5-2-2-3\" data-name=\"review footer date and label\">\n                        Published · 03 May 2024\n                        <span class=\"px-1.5\" data-kid=\"1-2-5-2-2-3-1\" data-name=\"footer separator dot\">\n                            ·\n                        </span>\n                        Fictional example\n                    </p>\n                </article>\n            </div>\n        </section>\n        <section aria-labelledby=\"privacy-title\" class=\"border-y border-[#e2e3dd] bg-[#f2f3ed]\" data-kid=\"1-2-6\" data-name=\"privacy and moderation section\">\n            <div class=\"mx-auto grid max-w-[1120px] grid-cols-[1.1fr_.9fr] gap-16 px-8 py-[71px] max-md:grid-cols-1 max-md:gap-8 max-md:px-5 max-md:py-12\" data-kid=\"1-2-6-1\" data-name=\"privacy two-column container\">\n                <div data-kid=\"1-2-6-1-1\" data-name=\"privacy left column copy\">\n                    <h2 class=\"max-w-[610px] text-[34px] font-medium leading-[1.2] tracking-[-1.3px] max-md:text-[29px]\" data-kid=\"1-2-6-1-1-1\" data-name=\"privacy section headline\" id=\"privacy-title\">\n                        Your experience. Shared on your terms.\n                    </h2>\n                    <p class=\"mt-4 max-w-[610px] text-[15px] leading-[1.75] text-[#566057]\" data-kid=\"1-2-6-1-1-2\" data-name=\"privacy description text\">\n                        You don’t need an account to submit a review, and public reviews don’t display the author’s identity. Every submission is reviewed by a person before publication. Moderation helps keep the community useful; it does not mean every statement has been independently verified.\n                    </p>\n                    <div class=\"mt-6 flex flex-wrap gap-x-6 gap-y-3 text-[14px]\" data-kid=\"1-2-6-1-1-3\" data-name=\"policy links row\">\n                        <a class=\"font-medium text-[#286144] underline decoration-[#9bb6a0] underline-offset-4 hover:text-[#1f4e35] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#286144]\" data-kid=\"1-2-6-1-1-3-1\" data-name=\"community guidelines link\" href=\"/community-guidelines\">\n                            Read the Community Guidelines ↗\n                        </a>\n                        <a class=\"font-medium text-[#286144] underline decoration-[#9bb6a0] underline-offset-4 hover:text-[#1f4e35] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#286144]\" data-kid=\"1-2-6-1-1-3-2\" data-name=\"privacy policy link\" href=\"/privacy\">\n                            Read the Privacy Policy ↗\n                        </a>\n                    </div>\n                </div>\n                <div class=\"border-l border-[#d3d9d1] pl-8 max-md:border-l-0 max-md:border-t max-md:pl-0 max-md:pt-6\" data-kid=\"1-2-6-1-2\" data-name=\"privacy right column checklist\">\n                    <p class=\"flex items-start gap-3 text-[14px] leading-[1.65] text-[#39413a]\" data-kid=\"1-2-6-1-2-1\" data-name=\"checklist item no account needed\">\n                        <span aria-hidden=\"true\" class=\"mt-0.5 text-[#286144]\" data-kid=\"1-2-6-1-2-1-1\" data-name=\"checkmark icon\">\n                            ✓\n                        </span>\n                        <span data-kid=\"1-2-6-1-2-1-2\" data-name=\"checklist item text\">\n                            <strong class=\"font-semibold\" data-kid=\"1-2-6-1-2-1-2-1\" data-name=\"checklist item bold label\">\n                                No account needed.\n                            </strong>\n                            Submit a workplace review without signing up.\n                        </span>\n                    </p>\n                    <p class=\"mt-4 flex items-start gap-3 text-[14px] leading-[1.65] text-[#39413a]\" data-kid=\"1-2-6-1-2-2\" data-name=\"checklist item identity not shown\">\n                        <span aria-hidden=\"true\" class=\"mt-0.5 text-[#286144]\" data-kid=\"1-2-6-1-2-2-1\" data-name=\"checkmark icon\">\n                            ✓\n                        </span>\n                        <span data-kid=\"1-2-6-1-2-2-2\" data-name=\"checklist item text\">\n                            <strong class=\"font-semibold\" data-kid=\"1-2-6-1-2-2-2-1\" data-name=\"checklist item bold label\">\n                                Identity not shown publicly.\n                            </strong>\n                            Reviews are displayed without the author’s name.\n                        </span>\n                    </p>\n                    <p class=\"mt-4 flex items-start gap-3 text-[14px] leading-[1.65] text-[#39413a]\" data-kid=\"1-2-6-1-2-3\" data-name=\"checklist item human moderation\">\n                        <span aria-hidden=\"true\" class=\"mt-0.5 text-[#286144]\" data-kid=\"1-2-6-1-2-3-1\" data-name=\"checkmark icon\">\n                            ✓\n                        </span>\n                        <span data-kid=\"1-2-6-1-2-3-2\" data-name=\"checklist item text\">\n                            <strong class=\"font-semibold\" data-kid=\"1-2-6-1-2-3-2-1\" data-name=\"checklist item bold label\">\n                                Human moderation.\n                            </strong>\n                            A person reviews submissions before they can be published.\n                        </span>\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"final-cta-title\" class=\"mx-auto max-w-[1240px] px-8 py-[58px] max-md:px-5 max-md:py-10\" data-kid=\"1-2-7\" data-name=\"final call-to-action section\">\n            <div class=\"flex items-center justify-between gap-12 border-b border-[#d9ddd5] pb-[58px] max-md:flex-col max-md:items-start max-md:gap-6 max-md:pb-10\" data-kid=\"1-2-7-1\" data-name=\"final CTA row\">\n                <div class=\"max-w-[730px]\" data-kid=\"1-2-7-1-1\" data-name=\"final CTA copy block\">\n                    <h2 class=\"text-[37px] font-medium leading-[1.18] tracking-[-1.5px] max-md:text-[31px]\" data-kid=\"1-2-7-1-1-1\" data-name=\"final CTA headline\" id=\"final-cta-title\">\n                        Help someone make a better career decision.\n                    </h2>\n                    <p class=\"mt-4 max-w-[670px] text-[15px] leading-[1.7] text-[#626b63]\" data-kid=\"1-2-7-1-1-2\" data-name=\"final CTA description\">\n                        Your workplace experience could give someone the context they need before accepting their next offer.\n                    </p>\n                </div>\n                <div class=\"flex shrink-0 flex-col items-start gap-4\" data-kid=\"1-2-7-1-2\" data-name=\"final CTA actions stack\">\n                    <a class=\"inline-flex h-12 items-center justify-center rounded-[7px] bg-[#286144] px-5 text-[14px] font-medium text-white no-underline hover:bg-[#1f4e35] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#286144]\" data-kid=\"1-2-7-1-2-1\" data-name=\"primary CTA write anonymous review\" href=\"/write-review\">\n                        Write an Anonymous Review\n                        <span aria-hidden=\"true\" class=\"ml-2 text-[17px]\" data-kid=\"1-2-7-1-2-1-1\" data-name=\"external link arrow icon\">\n                            ↗\n                        </span>\n                    </a>\n                    <a class=\"text-[14px] font-medium text-[#286144] underline decoration-[#9bb6a0] underline-offset-4 hover:text-[#1f4e35] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#286144]\" data-kid=\"1-2-7-1-2-2\" data-name=\"secondary CTA find a company\" href=\"/companies\">\n                        Find a Company\n                    </a>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"bg-[#202923] text-[#eef1eb]\" data-kid=\"1-3\" data-name=\"site footer\">\n        <div class=\"mx-auto max-w-[1240px] px-8 pb-7 pt-10 max-md:px-5 max-md:pt-8\" data-kid=\"1-3-1\" data-name=\"footer inner container\">\n            <div class=\"grid grid-cols-[1.4fr_1fr_1fr] gap-10 max-md:grid-cols-1 max-md:gap-8\" data-kid=\"1-3-1-1\" data-name=\"footer columns grid\">\n                <div data-kid=\"1-3-1-1-1\" data-name=\"footer brand column\">\n                    <a class=\"flex w-fit items-center gap-2.5 text-[19px] font-semibold tracking-[-0.6px] text-[#fffefa] no-underline\" data-kid=\"1-3-1-1-1-1\" data-name=\"footer brand logo link\" href=\"/\">\n                        <span class=\"flex size-8 items-center justify-center rounded-[9px] bg-[#9fbea3] text-[16px] font-semibold text-[#202923]\" data-kid=\"1-3-1-1-1-1-1\" data-name=\"footer brand logomark w. badge\">\n                            w.\n                        </span>\n                        Worktruth\n                    </a>\n                    <p class=\"mt-3 max-w-[300px] text-[13px] leading-[1.65] text-[#b9c1b9]\" data-kid=\"1-3-1-1-1-2\" data-name=\"footer brand tagline\">\n                        More context for your next career move.\n                    </p>\n                </div>\n                <div data-kid=\"1-3-1-1-2\" data-name=\"footer explore links column\">\n                    <h2 class=\"text-[12px] font-semibold uppercase tracking-[0.08em] text-[#bec8bf]\" data-kid=\"1-3-1-1-2-1\" data-name=\"footer explore column heading\">\n                        Explore\n                    </h2>\n                    <div class=\"mt-4 flex flex-col items-start gap-3 text-[13px] text-[#eef1eb]\" data-kid=\"1-3-1-1-2-2\" data-name=\"footer explore links list\">\n                        <a class=\"text-inherit no-underline hover:text-[#bbd2bf]\" data-kid=\"1-3-1-1-2-2-1\" data-name=\"footer link explore companies\" href=\"/companies\">\n                            Explore Companies\n                        </a>\n                        <a class=\"text-inherit no-underline hover:text-[#bbd2bf]\" data-kid=\"1-3-1-1-2-2-2\" data-name=\"footer link write a review\" href=\"/write-review\">\n                            Write a Review\n                        </a>\n                        <a class=\"text-inherit no-underline hover:text-[#bbd2bf]\" data-kid=\"1-3-1-1-2-2-3\" data-name=\"footer link community guidelines\" href=\"/community-guidelines\">\n                            Community Guidelines\n                        </a>\n                    </div>\n                </div>\n                <div data-kid=\"1-3-1-1-3\" data-name=\"footer information links column\">\n                    <h2 class=\"text-[12px] font-semibold uppercase tracking-[0.08em] text-[#bec8bf]\" data-kid=\"1-3-1-1-3-1\" data-name=\"footer information column heading\">\n                        Information\n                    </h2>\n                    <div class=\"mt-4 flex flex-col items-start gap-3 text-[13px] text-[#eef1eb]\" data-kid=\"1-3-1-1-3-2\" data-name=\"footer information links list\">\n                        <a class=\"text-inherit no-underline hover:text-[#bbd2bf]\" data-kid=\"1-3-1-1-3-2-1\" data-name=\"footer link privacy policy\" href=\"/privacy\">\n                            Privacy Policy\n                        </a>\n                        <a class=\"text-inherit no-underline hover:text-[#bbd2bf]\" data-kid=\"1-3-1-1-3-2-2\" data-name=\"footer link terms of service\" href=\"/terms\">\n                            Terms of Service\n                        </a>\n                        <a class=\"text-inherit no-underline hover:text-[#bbd2bf]\" data-kid=\"1-3-1-1-3-2-3\" data-name=\"footer link contact\" href=\"/contact\">\n                            Contact\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-9 flex flex-wrap justify-between gap-3 border-t border-[#3b463e] pt-5 text-[12px] text-[#aeb8ae]\" data-kid=\"1-3-1-2\" data-name=\"footer bottom bar\">\n                <span data-kid=\"1-3-1-2-1\" data-name=\"footer copyright text\">\n                    © 2024 Worktruth. Fictional examples are labelled throughout.\n                </span>\n                <span data-kid=\"1-3-1-2-2\" data-name=\"footer tagline text\">\n                    Built for more thoughtful career decisions.\n                </span>\n            </div>\n        </div>\n    </footer>\n</div>\n",
