      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;450;500;550;600;650;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"min-h-screen bg-[#f8f7f2] text-[#202620] antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:Geist, sans-serif\">\n    <header class=\"border-b border-[#e4e5dd] bg-[#f8f7f2]\" data-kid=\"1-1\" data-name=\"site header\">\n        <div class=\"mx-auto flex h-[76px] max-w-[1160px] items-center justify-between px-5 md:px-8\" data-kid=\"1-1-1\" data-name=\"header bar container\">\n            <a aria-label=\"Worktruth home\" class=\"inline-flex items-center gap-2.5 text-[21px] font-semibold tracking-[-0.065em] text-[#202620] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#47745a]\" data-kid=\"1-1-1-1\" data-name=\"site logo link\" href=\"/\">\n                <span class=\"grid size-[25px] place-items-center rounded-[7px] bg-[#315a42] text-[15px] font-medium leading-none text-white\" data-kid=\"1-1-1-1-1\" data-name=\"logo tile\">\n                    w\n                </span>\n                <span data-kid=\"1-1-1-1-2\" data-name=\"site logo wordmark\">\n                    worktruth\n                </span>\n            </a>\n            <nav aria-label=\"Main navigation\" class=\"hidden items-center gap-8 md:flex\" data-kid=\"1-1-1-2\" data-name=\"main navigation\">\n                <a class=\"text-[14px] text-[#565d56] hover:text-[#244b34] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#47745a]\" data-kid=\"1-1-1-2-1\" data-name=\"nav link to companies\" href=\"/companies\">\n                    Explore Companies\n                </a>\n                <a class=\"text-[14px] text-[#565d56] hover:text-[#244b34] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#47745a]\" data-kid=\"1-1-1-2-2\" data-name=\"nav link to how it works\" href=\"#how-it-works\">\n                    How It Works\n                </a>\n                <a class=\"text-[14px] text-[#565d56] hover:text-[#244b34] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#47745a]\" data-kid=\"1-1-1-2-3\" data-name=\"nav link to community guidelines\" href=\"/community-guidelines\">\n                    Community Guidelines\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-3\" data-name=\"header actions container\">\n                <a class=\"hidden h-10 items-center justify-center rounded-md bg-[#315a42] px-4 text-[13px] font-medium text-white hover:bg-[#274c37] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#47745a] sm:inline-flex\" data-kid=\"1-1-1-3-1\" data-name=\"write review call-to-action button\" href=\"/write-review\">\n                    Write a Review\n                </a>\n                <details class=\"relative md:hidden\" data-kid=\"1-1-1-3-2\" data-name=\"mobile menu disclosure\">\n                    <summary aria-label=\"Open navigation menu\" class=\"grid size-10 cursor-pointer list-none place-items-center rounded-md border border-[#dedfd7] text-[19px] text-[#303a31] hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#47745a]\" data-kid=\"1-1-1-3-2-1\" data-name=\"mobile menu hamburger button\">\n                        <i class=\"icon-menu\" data-kid=\"1-1-1-3-2-1-1\" data-name=\"menu hamburger icon\">\n                        </i>\n                    </summary>\n                    <nav aria-label=\"Mobile navigation\" class=\"absolute right-0 top-12 z-20 w-60 rounded-lg border border-[#dfdfd6] bg-[#fffefa] p-2 shadow-lg\" data-kid=\"1-1-1-3-2-2\" data-name=\"mobile navigation panel\">\n                        <a class=\"block rounded-md px-3 py-3 text-sm hover:bg-[#f3f4ee] focus-visible:outline-2 focus-visible:outline-[#47745a]\" data-kid=\"1-1-1-3-2-2-1\" data-name=\"mobile nav link to companies\" href=\"/companies\">\n                            Explore Companies\n                        </a>\n                        <a class=\"block rounded-md px-3 py-3 text-sm hover:bg-[#f3f4ee] focus-visible:outline-2 focus-visible:outline-[#47745a]\" data-kid=\"1-1-1-3-2-2-2\" data-name=\"mobile nav link to how it works\" href=\"#how-it-works\">\n                            How It Works\n                        </a>\n                        <a class=\"block rounded-md px-3 py-3 text-sm hover:bg-[#f3f4ee] focus-visible:outline-2 focus-visible:outline-[#47745a]\" data-kid=\"1-1-1-3-2-2-3\" data-name=\"mobile nav link to community guidelines\" href=\"/community-guidelines\">\n                            Community Guidelines\n                        </a>\n                        <a class=\"mt-1 block rounded-md bg-[#315a42] px-3 py-3 text-sm font-medium text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#47745a]\" data-kid=\"1-1-1-3-2-2-4\" data-name=\"mobile write review button\" href=\"/write-review\">\n                            Write a Review\n                        </a>\n                    </nav>\n                </details>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content\">\n        <section aria-labelledby=\"hero-title\" class=\"mx-auto max-w-[1160px] px-5 pb-12 pt-[58px] md:px-8 md:pb-[66px] md:pt-[82px]\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div class=\"max-w-[780px]\" data-kid=\"1-2-1-1\" data-name=\"hero text block\">\n                <h1 class=\"max-w-[760px] text-[42px] font-medium leading-[1.08] tracking-[-0.065em] text-[#202620] sm:text-[52px] md:text-[64px]\" data-kid=\"1-2-1-1-1\" data-name=\"hero headline\" id=\"hero-title\">\n                    Know what it's really like to work there.\n                </h1>\n                <p class=\"mt-6 max-w-[660px] text-[16px] leading-[1.75] text-[#5a615b] md:text-[18px]\" data-kid=\"1-2-1-1-2\" data-name=\"hero subheading\">\n                    Honest workplace experiences from people who have been there. Research Nigerian tech companies before you make your next career move.\n                </p>\n                <form action=\"/companies\" class=\"mt-8 flex max-w-[700px] flex-col gap-2 rounded-lg border border-[#d9dbd2] bg-[#fffefa] p-2 shadow-[0_2px_12px_rgba(29,40,31,0.035)] sm:flex-row sm:items-center sm:gap-3\" data-kid=\"1-2-1-1-3\" data-name=\"company search form\" method=\"get\" role=\"search\">\n                    <label class=\"sr-only\" data-kid=\"1-2-1-1-3-1\" data-name=\"search field label\" for=\"company-search\">\n                        Search companies in Nigeria\n                    </label>\n                    <span class=\"flex min-h-[48px] flex-1 items-center gap-3 px-3 text-[19px] text-[#6f786f]\" data-kid=\"1-2-1-1-3-2\" data-name=\"search input wrapper\">\n                        <i class=\"icon-search\" data-kid=\"1-2-1-1-3-2-1\" data-name=\"search icon\">\n                        </i>\n                        <input class=\"min-w-0 flex-1 bg-transparent text-[15px] text-[#202620] placeholder:text-[#858a83] outline-none focus-visible:ring-0\" data-kid=\"1-2-1-1-3-2-2\" data-name=\"company search input field\" id=\"company-search\" name=\"q\" placeholder=\"Search companies in Nigeria...\" type=\"search\"/>\n                    </span>\n                    <button class=\"inline-flex h-12 shrink-0 items-center justify-center gap-2 rounded-md bg-[#315a42] px-5 text-[14px] font-medium text-white hover:bg-[#274c37] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#47745a]\" data-kid=\"1-2-1-1-3-3\" data-name=\"search submit button\" type=\"submit\">\n                        Search companies\n                        <i class=\"icon-arrow-up-right text-[15px]\" data-kid=\"1-2-1-1-3-3-1\" data-name=\"arrow up-right icon\">\n                        </i>\n                    </button>\n                </form>\n                <div class=\"mt-5 flex flex-wrap items-center gap-x-5 gap-y-2\" data-kid=\"1-2-1-1-4\" data-name=\"hero meta row\">\n                    <a class=\"text-[14px] font-medium text-[#315a42] underline decoration-[#9aaf9e] underline-offset-4 hover:text-[#203e2c] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#47745a]\" data-kid=\"1-2-1-1-4-1\" data-name=\"share experience link\" href=\"/write-review\">\n                        Share Your Experience\n                    </a>\n                    <span class=\"hidden h-4 border-l border-[#d7d9d1] sm:block\" data-kid=\"1-2-1-1-4-2\" data-name=\"divider separator\">\n                    </span>\n                    <p class=\"inline-flex items-center gap-2 text-[13px] text-[#666d66]\" data-kid=\"1-2-1-1-4-3\" data-name=\"anonymous reading note\">\n                        <i class=\"icon-lock-keyhole text-[14px] text-[#47745a]\" data-kid=\"1-2-1-1-4-3-1\" data-name=\"lock keyhole icon\">\n                        </i>\n                        Read anonymously. Share without an account.\n                    </p>\n                </div>\n            </div>\n            <div class=\"mt-[54px] border-t border-[#dedfd7] pt-5 md:mt-[66px]\" data-kid=\"1-2-1-2\" data-name=\"company directory sample block\">\n                <div class=\"mb-4 flex flex-wrap items-center justify-between gap-2\" data-kid=\"1-2-1-2-1\" data-name=\"directory sample header\">\n                    <h2 class=\"text-[13px] font-medium text-[#303a31]\" data-kid=\"1-2-1-2-1-1\" data-name=\"sample section heading\">\n                        A sample from the company directory\n                    </h2>\n                    <span class=\"inline-flex items-center gap-2 text-[12px] text-[#747a72]\" data-kid=\"1-2-1-2-1-2\" data-name=\"demo data disclaimer badge\">\n                        <span class=\"size-1.5 rounded-full bg-[#6e9276]\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"status dot indicator\">\n                        </span>\n                        Fictional examples · demo data\n                    </span>\n                </div>\n                <div class=\"grid overflow-hidden rounded-lg border border-[#dedfd7] bg-[#fffefa] md:grid-cols-[1.5fr_0.9fr]\" data-kid=\"1-2-1-2-2\" data-name=\"sample directory card grid\">\n                    <article class=\"p-5 sm:p-7 md:p-8\" data-kid=\"1-2-1-2-2-1\" data-name=\"featured sample company card\">\n                        <div class=\"flex flex-wrap items-start justify-between gap-3\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"card header row\">\n                            <div data-kid=\"1-2-1-2-2-1-1-1\" data-name=\"company identity block\">\n                                <p class=\"text-[12px] text-[#747a72]\" data-kid=\"1-2-1-2-2-1-1-1-1\" data-name=\"company meta label\">\n                                    Fictional company · Software · Lagos\n                                </p>\n                                <h3 class=\"mt-2 text-[23px] font-medium tracking-[-0.04em] text-[#202620]\" data-kid=\"1-2-1-2-2-1-1-1-2\" data-name=\"company name heading\">\n                                    SampleStack Labs\n                                </h3>\n                            </div>\n                            <a aria-label=\"View SampleStack Labs demo reviews\" class=\"shrink-0 rounded-md px-2 py-1 text-[13px] font-medium text-[#315a42] hover:bg-[#f0f3ed] focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[#47745a]\" data-kid=\"1-2-1-2-2-1-1-2\" data-name=\"view reviews link\" href=\"/companies?company=samplestack-labs\">\n                                View reviews\n                                <span aria-hidden=\"true\" data-kid=\"1-2-1-2-2-1-1-2-1\" data-name=\"arrow symbol\">\n                                    ↗\n                                </span>\n                            </a>\n                        </div>\n                        <div class=\"mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 border-y border-[#ecece6] py-3\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"review stats row\">\n                            <span class=\"inline-flex items-center gap-1.5 text-[18px] font-semibold tracking-[-0.04em] text-[#202620]\" data-kid=\"1-2-1-2-2-1-2-1\" data-name=\"star rating value\">\n                                <i class=\"icon-star text-[15px] text-[#66846a]\" data-kid=\"1-2-1-2-2-1-2-1-1\" data-name=\"star icon\">\n                                </i>\n                                4.2\n                            </span>\n                            <span class=\"text-[13px] text-[#70766f]\" data-kid=\"1-2-1-2-2-1-2-2\" data-name=\"rating scale label\">\n                                / 5\n                            </span>\n                            <span class=\"h-4 border-l border-[#dfe0d9]\" data-kid=\"1-2-1-2-2-1-2-3\" data-name=\"stat divider\">\n                            </span>\n                            <span class=\"text-[13px] text-[#565d56]\" data-kid=\"1-2-1-2-2-1-2-4\" data-name=\"review count text\">\n                                12 sample reviews\n                            </span>\n                        </div>\n                        <div class=\"mt-4 grid gap-4 sm:grid-cols-[0.65fr_1.35fr]\" data-kid=\"1-2-1-2-2-1-3\" data-name=\"quote block\">\n                            <div data-kid=\"1-2-1-2-2-1-3-1\" data-name=\"review author meta\">\n                                <p class=\"text-[12px] font-medium text-[#405c46]\" data-kid=\"1-2-1-2-2-1-3-1-1\" data-name=\"review type label\">\n                                    Fictional review\n                                </p>\n                                <p class=\"mt-1.5 text-[13px] leading-5 text-[#697069]\" data-kid=\"1-2-1-2-2-1-3-1-2\" data-name=\"review author role\">\n                                    Product designer · Former employee\n                                </p>\n                            </div>\n                            <blockquote class=\"border-l border-[#a8b9a8] pl-4 text-[14px] leading-[1.65] text-[#434a43]\" data-kid=\"1-2-1-2-2-1-3-2\" data-name=\"review quote text\">\n                                “Thoughtful teammates and plenty of ownership. Priorities could shift quickly, so clear communication made a real difference.”\n                            </blockquote>\n                        </div>\n                    </article>\n                    <div class=\"border-t border-[#e8e8e1] bg-[#f5f5ef] px-5 py-4 md:border-l md:border-t-0 md:px-6 md:py-5\" data-kid=\"1-2-1-2-2-2\" data-name=\"other examples panel\">\n                        <h3 class=\"text-[12px] font-medium text-[#747a72]\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"other examples heading\">\n                            More fictional examples\n                        </h3>\n                        <a class=\"group flex items-center justify-between gap-3 border-b border-[#e1e2d9] py-4 focus-visible:outline-2 focus-visible:outline-[#47745a]\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"other example link row\" href=\"/companies?company=demoworks-digital\">\n                            <span data-kid=\"1-2-1-2-2-2-2-1\" data-name=\"example info block\">\n                                <span class=\"block text-[14px] font-medium text-[#303a31] group-hover:text-[#315a42]\" data-kid=\"1-2-1-2-2-2-2-1-1\" data-name=\"example company name\">\n                                    DemoWorks Digital\n                                </span>\n                                <span class=\"mt-1 block text-[12px] text-[#747a72]\" data-kid=\"1-2-1-2-2-2-2-1-2\" data-name=\"example location and review count\">\n                                    Abuja · 4 sample reviews\n                                </span>\n                            </span>\n                            <span class=\"text-[13px] text-[#315a42]\" data-kid=\"1-2-1-2-2-2-2-2\" data-name=\"example rating value\">\n                                3.8\n                                <i class=\"icon-star text-[11px]\" data-kid=\"1-2-1-2-2-2-2-2-1\" data-name=\"star icon\">\n                                </i>\n                            </span>\n                        </a>\n                        <a class=\"group flex items-center justify-between gap-3 py-4 focus-visible:outline-2 focus-visible:outline-[#47745a]\" data-kid=\"1-2-1-2-2-2-3\" data-name=\"other example link row\" href=\"/companies?company=placeholder-systems\">\n                            <span data-kid=\"1-2-1-2-2-2-3-1\" data-name=\"example info block\">\n                                <span class=\"block text-[14px] font-medium text-[#303a31] group-hover:text-[#315a42]\" data-kid=\"1-2-1-2-2-2-3-1-1\" data-name=\"example company name\">\n                                    Placeholder Systems\n                                </span>\n                                <span class=\"mt-1 block text-[12px] text-[#747a72]\" data-kid=\"1-2-1-2-2-2-3-1-2\" data-name=\"example location and status\">\n                                    Remote · No published reviews\n                                </span>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"text-[17px] text-[#758076] group-hover:text-[#315a42]\" data-kid=\"1-2-1-2-2-2-3-2\" data-name=\"arrow symbol\">\n                                →\n                            </span>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"context-title\" class=\"border-y border-[#e4e5dd] bg-[#f3f3ed]\" data-kid=\"1-2-2\" data-name=\"why use section with background\">\n            <div class=\"mx-auto max-w-[1160px] px-5 py-[58px] md:px-8 md:py-[78px]\" data-kid=\"1-2-2-1\" data-name=\"why use section container\">\n                <h2 class=\"max-w-[540px] text-[30px] font-medium leading-tight tracking-[-0.05em] sm:text-[38px]\" data-kid=\"1-2-2-1-1\" data-name=\"why use headline\" id=\"context-title\">\n                    Make career decisions with more context.\n                </h2>\n                <div class=\"mt-10 grid gap-8 md:grid-cols-3 md:gap-10\" data-kid=\"1-2-2-1-2\" data-name=\"feature card grid\">\n                    <article class=\"border-t border-[#d8dbd2] pt-5\" data-kid=\"1-2-2-1-2-1\" data-name=\"feature card for real experiences\">\n                        <i aria-hidden=\"true\" class=\"icon-messages-square text-[21px] text-[#47745a]\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"messages square icon\">\n                        </i>\n                        <h3 class=\"mt-4 text-[16px] font-medium tracking-[-0.02em]\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"feature card title\">\n                            Real Workplace Experiences\n                        </h3>\n                        <p class=\"mt-2 max-w-[310px] text-[14px] leading-[1.7] text-[#626a62]\" data-kid=\"1-2-2-1-2-1-3\" data-name=\"feature card description\">\n                            Learn from current and former employees, in their own words.\n                        </p>\n                    </article>\n                    <article class=\"border-t border-[#d8dbd2] pt-5\" data-kid=\"1-2-2-1-2-2\" data-name=\"feature card for anonymity\">\n                        <i aria-hidden=\"true\" class=\"icon-user-round text-[21px] text-[#47745a]\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"user round icon\">\n                        </i>\n                        <h3 class=\"mt-4 text-[16px] font-medium tracking-[-0.02em]\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"feature card title\">\n                            Anonymous by Design\n                        </h3>\n                        <p class=\"mt-2 max-w-[310px] text-[14px] leading-[1.7] text-[#626a62]\" data-kid=\"1-2-2-1-2-2-3\" data-name=\"feature card description\">\n                            Share without creating an account. Your identity isn't displayed publicly.\n                        </p>\n                    </article>\n                    <article class=\"border-t border-[#d8dbd2] pt-5\" data-kid=\"1-2-2-1-2-3\" data-name=\"feature card for moderation\">\n                        <i aria-hidden=\"true\" class=\"icon-clipboard-check text-[21px] text-[#47745a]\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"clipboard check icon\">\n                        </i>\n                        <h3 class=\"mt-4 text-[16px] font-medium tracking-[-0.02em]\" data-kid=\"1-2-2-1-2-3-2\" data-name=\"feature card title\">\n                            Human-Reviewed Feedback\n                        </h3>\n                        <p class=\"mt-2 max-w-[310px] text-[14px] leading-[1.7] text-[#626a62]\" data-kid=\"1-2-2-1-2-3-3\" data-name=\"feature card description\">\n                            Every review is moderated by a person before publication.\n                        </p>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"how-title\" class=\"mx-auto max-w-[1160px] px-5 py-[68px] md:px-8 md:py-[92px]\" data-kid=\"1-2-3\" data-name=\"how it works section\" id=\"how-it-works\">\n            <div class=\"max-w-[560px]\" data-kid=\"1-2-3-1\" data-name=\"how it works header\">\n                <h2 class=\"text-[31px] font-medium tracking-[-0.05em] sm:text-[39px]\" data-kid=\"1-2-3-1-1\" data-name=\"how it works headline\" id=\"how-title\">\n                    How it works\n                </h2>\n                <p class=\"mt-3 text-[15px] leading-7 text-[#626a62]\" data-kid=\"1-2-3-1-2\" data-name=\"how it works subheading\">\n                    A clearer picture starts with a company name, then grows with shared experience.\n                </p>\n            </div>\n            <ol class=\"mt-10 grid gap-8 md:mt-12 md:grid-cols-3 md:gap-8\" data-kid=\"1-2-3-2\" data-name=\"how it works steps\">\n                <li class=\"relative border-t border-[#d8dbd2] pt-5 md:pr-10\" data-kid=\"1-2-3-2-1\" data-name=\"step one card\">\n                    <span class=\"text-[12px] font-medium text-[#54785c]\" data-kid=\"1-2-3-2-1-1\" data-name=\"step number label\">\n                        01\n                    </span>\n                    <h3 class=\"mt-3 text-[19px] font-medium tracking-[-0.03em]\" data-kid=\"1-2-3-2-1-2\" data-name=\"step one heading\">\n                        Find a company.\n                    </h3>\n                    <p class=\"mt-2 max-w-[290px] text-[14px] leading-[1.7] text-[#626a62]\" data-kid=\"1-2-3-2-1-3\" data-name=\"step one description\">\n                        Search the Nigerian tech directory for a workplace you want to understand.\n                    </p>\n                    <i aria-hidden=\"true\" class=\"icon-arrow-right absolute right-1 top-5 hidden text-[18px] text-[#94a395] md:block\" data-kid=\"1-2-3-2-1-4\" data-name=\"arrow right icon\">\n                    </i>\n                </li>\n                <li class=\"relative border-t border-[#d8dbd2] pt-5 md:pr-10\" data-kid=\"1-2-3-2-2\" data-name=\"step two card\">\n                    <span class=\"text-[12px] font-medium text-[#54785c]\" data-kid=\"1-2-3-2-2-1\" data-name=\"step number label\">\n                        02\n                    </span>\n                    <h3 class=\"mt-3 text-[19px] font-medium tracking-[-0.03em]\" data-kid=\"1-2-3-2-2-2\" data-name=\"step two heading\">\n                        Read employee experiences.\n                    </h3>\n                    <p class=\"mt-2 max-w-[290px] text-[14px] leading-[1.7] text-[#626a62]\" data-kid=\"1-2-3-2-2-3\" data-name=\"step two description\">\n                        Explore perspectives on culture, management, pay, balance, and growth.\n                    </p>\n                    <i aria-hidden=\"true\" class=\"icon-arrow-right absolute right-1 top-5 hidden text-[18px] text-[#94a395] md:block\" data-kid=\"1-2-3-2-2-4\" data-name=\"arrow right icon\">\n                    </i>\n                </li>\n                <li class=\"border-t border-[#d8dbd2] pt-5\" data-kid=\"1-2-3-2-3\" data-name=\"step three card\">\n                    <span class=\"text-[12px] font-medium text-[#54785c]\" data-kid=\"1-2-3-2-3-1\" data-name=\"step number label\">\n                        03\n                    </span>\n                    <h3 class=\"mt-3 text-[19px] font-medium tracking-[-0.03em]\" data-kid=\"1-2-3-2-3-2\" data-name=\"step three heading\">\n                        Share your own experience anonymously.\n                    </h3>\n                    <p class=\"mt-2 max-w-[290px] text-[14px] leading-[1.7] text-[#626a62]\" data-kid=\"1-2-3-2-3-3\" data-name=\"step three description\">\n                        Submit without an account. A human reviews each submission before it can be published.\n                    </p>\n                </li>\n            </ol>\n        </section>\n        <section aria-labelledby=\"companies-title\" class=\"border-y border-[#e4e5dd] bg-[#f3f3ed]\" data-kid=\"1-2-4\" data-name=\"company discovery section\" id=\"company-discovery\">\n            <div class=\"mx-auto max-w-[1160px] px-5 py-[62px] md:px-8 md:py-[86px]\" data-kid=\"1-2-4-1\" data-name=\"company discovery container\">\n                <div class=\"flex flex-col justify-between gap-5 sm:flex-row sm:items-end\" data-kid=\"1-2-4-1-1\" data-name=\"company discovery header\">\n                    <div class=\"max-w-[650px]\" data-kid=\"1-2-4-1-1-1\" data-name=\"header text block\">\n                        <h2 class=\"text-[30px] font-medium leading-tight tracking-[-0.05em] sm:text-[38px]\" data-kid=\"1-2-4-1-1-1-1\" data-name=\"company discovery headline\" id=\"companies-title\">\n                            Get to know the companies behind the job titles.\n                        </h2>\n                        <p class=\"mt-3 text-[14px] leading-6 text-[#626a62]\" data-kid=\"1-2-4-1-1-1-2\" data-name=\"company discovery subheading\">\n                            A small preview of fictional Nigerian tech workplaces. All names and review data below are demo examples.\n                        </p>\n                    </div>\n                    <a class=\"inline-flex items-center gap-2 self-start whitespace-nowrap text-[14px] font-medium text-[#315a42] underline decoration-[#a3b6a5] underline-offset-4 hover:text-[#203e2c] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#47745a] sm:self-auto\" data-kid=\"1-2-4-1-1-2\" data-name=\"explore companies link\" href=\"/companies\">\n                        Explore Companies\n                        <i class=\"icon-arrow-up-right text-[15px]\" data-kid=\"1-2-4-1-1-2-1\" data-name=\"arrow up-right icon\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4\" data-kid=\"1-2-4-1-2\" data-name=\"company card grid\">\n                    <a class=\"group flex min-h-[205px] flex-col rounded-md border border-[#dedfd7] bg-[#fffefa] p-5 hover:border-[#a7b9a7] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#47745a]\" data-kid=\"1-2-4-1-2-1\" data-name=\"company card for SampleStack Labs\" href=\"/companies?company=samplestack-labs\">\n                        <span class=\"text-[11px] text-[#777e76]\" data-kid=\"1-2-4-1-2-1-1\" data-name=\"company card location label\">\n                            Fictional demo · Lagos\n                        </span>\n                        <h3 class=\"mt-3 text-[17px] font-medium tracking-[-0.025em] group-hover:text-[#315a42]\" data-kid=\"1-2-4-1-2-1-2\" data-name=\"company card company name\">\n                            SampleStack Labs\n                        </h3>\n                        <p class=\"mt-1 text-[12px] text-[#777e76]\" data-kid=\"1-2-4-1-2-1-3\" data-name=\"company card industry label\">\n                            Software products\n                        </p>\n                        <div class=\"mt-auto flex items-center gap-2 border-t border-[#ecece6] pt-4\" data-kid=\"1-2-4-1-2-1-4\" data-name=\"company card stats row\">\n                            <span class=\"inline-flex items-center gap-1 text-[14px] font-semibold\" data-kid=\"1-2-4-1-2-1-4-1\" data-name=\"company card star rating\">\n                                <i class=\"icon-star text-[12px] text-[#66846a]\" data-kid=\"1-2-4-1-2-1-4-1-1\" data-name=\"star icon\">\n                                </i>\n                                4.2\n                            </span>\n                            <span class=\"text-[12px] text-[#777e76]\" data-kid=\"1-2-4-1-2-1-4-2\" data-name=\"company card review count\">\n                                · 12 sample reviews\n                            </span>\n                        </div>\n                        <p class=\"mt-2 text-[12px] text-[#555e56]\" data-kid=\"1-2-4-1-2-1-5\" data-name=\"company card short quote\">\n                            “Thoughtful teammates, shifting priorities.”\n                        </p>\n                    </a>\n                    <a class=\"group flex min-h-[205px] flex-col rounded-md border border-[#dedfd7] bg-[#fffefa] p-5 hover:border-[#a7b9a7] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#47745a]\" data-kid=\"1-2-4-1-2-2\" data-name=\"company card for DemoWorks Digital\" href=\"/companies?company=demoworks-digital\">\n                        <span class=\"text-[11px] text-[#777e76]\" data-kid=\"1-2-4-1-2-2-1\" data-name=\"company card location label\">\n                            Fictional demo · Abuja\n                        </span>\n                        <h3 class=\"mt-3 text-[17px] font-medium tracking-[-0.025em] group-hover:text-[#315a42]\" data-kid=\"1-2-4-1-2-2-2\" data-name=\"company card company name\">\n                            DemoWorks Digital\n                        </h3>\n                        <p class=\"mt-1 text-[12px] text-[#777e76]\" data-kid=\"1-2-4-1-2-2-3\" data-name=\"company card industry label\">\n                            Digital services\n                        </p>\n                        <div class=\"mt-auto flex items-center gap-2 border-t border-[#ecece6] pt-4\" data-kid=\"1-2-4-1-2-2-4\" data-name=\"company card stats row\">\n                            <span class=\"inline-flex items-center gap-1 text-[14px] font-semibold\" data-kid=\"1-2-4-1-2-2-4-1\" data-name=\"company card star rating\">\n                                <i class=\"icon-star text-[12px] text-[#66846a]\" data-kid=\"1-2-4-1-2-2-4-1-1\" data-name=\"star icon\">\n                                </i>\n                                3.8\n                            </span>\n                            <span class=\"text-[12px] text-[#777e76]\" data-kid=\"1-2-4-1-2-2-4-2\" data-name=\"company card review count\">\n                                · 4 sample reviews\n                            </span>\n                        </div>\n                        <p class=\"mt-2 text-[12px] text-[#555e56]\" data-kid=\"1-2-4-1-2-2-5\" data-name=\"company card short quote\">\n                            “Supportive peers; clearer priorities help.”\n                        </p>\n                    </a>\n                    <a class=\"group flex min-h-[205px] flex-col rounded-md border border-[#dedfd7] bg-[#fffefa] p-5 hover:border-[#a7b9a7] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#47745a]\" data-kid=\"1-2-4-1-2-3\" data-name=\"company card for Fictional Product Studio\" href=\"/companies?company=fictional-product-studio\">\n                        <span class=\"text-[11px] text-[#777e76]\" data-kid=\"1-2-4-1-2-3-1\" data-name=\"company card location label\">\n                            Fictional demo · Ibadan\n                        </span>\n                        <h3 class=\"mt-3 text-[17px] font-medium tracking-[-0.025em] group-hover:text-[#315a42]\" data-kid=\"1-2-4-1-2-3-2\" data-name=\"company card company name\">\n                            Fictional Product Studio\n                        </h3>\n                        <p class=\"mt-1 text-[12px] text-[#777e76]\" data-kid=\"1-2-4-1-2-3-3\" data-name=\"company card industry label\">\n                            Product design\n                        </p>\n                        <div class=\"mt-auto border-t border-[#ecece6] pt-4\" data-kid=\"1-2-4-1-2-3-4\" data-name=\"company card no reviews row\">\n                            <span class=\"text-[12px] font-medium text-[#555e56]\" data-kid=\"1-2-4-1-2-3-4-1\" data-name=\"no published reviews label\">\n                                No published reviews\n                            </span>\n                        </div>\n                        <p class=\"mt-2 text-[12px] text-[#777e76]\" data-kid=\"1-2-4-1-2-3-5\" data-name=\"company card teaser text\">\n                            Be the first to share context.\n                        </p>\n                    </a>\n                    <a class=\"group flex min-h-[205px] flex-col rounded-md border border-[#dedfd7] bg-[#fffefa] p-5 hover:border-[#a7b9a7] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#47745a]\" data-kid=\"1-2-4-1-2-4\" data-name=\"company card for Placeholder Systems\" href=\"/companies?company=placeholder-systems\">\n                        <span class=\"text-[11px] text-[#777e76]\" data-kid=\"1-2-4-1-2-4-1\" data-name=\"company card location label\">\n                            Fictional demo · Remote, Nigeria\n                        </span>\n                        <h3 class=\"mt-3 text-[17px] font-medium tracking-[-0.025em] group-hover:text-[#315a42]\" data-kid=\"1-2-4-1-2-4-2\" data-name=\"company card company name\">\n                            Placeholder Systems\n                        </h3>\n                        <p class=\"mt-1 text-[12px] text-[#777e76]\" data-kid=\"1-2-4-1-2-4-3\" data-name=\"company card industry label\">\n                            Cloud tools\n                        </p>\n                        <div class=\"mt-auto border-t border-[#ecece6] pt-4\" data-kid=\"1-2-4-1-2-4-4\" data-name=\"company card no reviews row\">\n                            <span class=\"text-[12px] font-medium text-[#555e56]\" data-kid=\"1-2-4-1-2-4-4-1\" data-name=\"no published reviews label\">\n                                No published reviews\n                            </span>\n                        </div>\n                        <p class=\"mt-2 text-[12px] text-[#777e76]\" data-kid=\"1-2-4-1-2-4-5\" data-name=\"company card teaser text\">\n                            No rating until reviews exist.\n                        </p>\n                    </a>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"reviews-title\" class=\"mx-auto max-w-[1160px] px-5 py-[68px] md:px-8 md:py-[92px]\" data-kid=\"1-2-5\" data-name=\"reviews examples section\">\n            <div class=\"max-w-[640px]\" data-kid=\"1-2-5-1\" data-name=\"reviews examples header\">\n                <h2 class=\"text-[30px] font-medium leading-tight tracking-[-0.05em] sm:text-[38px]\" data-kid=\"1-2-5-1-1\" data-name=\"reviews examples headline\" id=\"reviews-title\">\n                    More than a rating. Real workplace context.\n                </h2>\n                <p class=\"mt-3 text-[14px] leading-6 text-[#626a62]\" data-kid=\"1-2-5-1-2\" data-name=\"reviews examples subheading\">\n                    Fictional review examples show how a rating can sit alongside both the good and the difficult.\n                </p>\n            </div>\n            <div class=\"mt-9 grid gap-4 md:grid-cols-2\" data-kid=\"1-2-5-2\" data-name=\"review card grid\">\n                <article class=\"rounded-md border border-[#dedfd7] bg-[#fffefa] p-5 sm:p-7\" data-kid=\"1-2-5-2-1\" data-name=\"review card for SampleStack Labs\">\n                    <div class=\"flex flex-wrap items-center justify-between gap-3 border-b border-[#ecece6] pb-4\" data-kid=\"1-2-5-2-1-1\" data-name=\"review card header\">\n                        <div data-kid=\"1-2-5-2-1-1-1\" data-name=\"review author block\">\n                            <p class=\"text-[11px] text-[#777e76]\" data-kid=\"1-2-5-2-1-1-1-1\" data-name=\"review company label\">\n                                Fictional review · SampleStack Labs\n                            </p>\n                            <p class=\"mt-1.5 text-[13px] font-medium text-[#39413a]\" data-kid=\"1-2-5-2-1-1-1-2\" data-name=\"review author role\">\n                                Software engineer · Former employee\n                            </p>\n                        </div>\n                        <div class=\"inline-flex items-center gap-1.5 text-[14px] font-semibold\" data-kid=\"1-2-5-2-1-1-2\" data-name=\"review card rating value\">\n                            <i class=\"icon-star text-[13px] text-[#66846a]\" data-kid=\"1-2-5-2-1-1-2-1\" data-name=\"star icon\">\n                            </i>\n                            4.1\n                            <span class=\"font-normal text-[#777e76]\" data-kid=\"1-2-5-2-1-1-2-2\" data-name=\"rating scale label\">\n                                / 5\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"mt-5 grid gap-5 sm:grid-cols-2\" data-kid=\"1-2-5-2-1-2\" data-name=\"pros and cons grid\">\n                        <div data-kid=\"1-2-5-2-1-2-1\" data-name=\"review pros block\">\n                            <h3 class=\"text-[12px] font-semibold text-[#46694d]\" data-kid=\"1-2-5-2-1-2-1-1\" data-name=\"pros heading\">\n                                Pros\n                            </h3>\n                            <p class=\"mt-2 text-[13px] leading-[1.7] text-[#555e56]\" data-kid=\"1-2-5-2-1-2-1-2\" data-name=\"pros text\">\n                                People were generous with their time, and I had room to take ownership of work from planning through delivery.\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-5-2-1-2-2\" data-name=\"review cons block\">\n                            <h3 class=\"text-[12px] font-semibold text-[#626a62]\" data-kid=\"1-2-5-2-1-2-2-1\" data-name=\"cons heading\">\n                                Cons\n                            </h3>\n                            <p class=\"mt-2 text-[13px] leading-[1.7] text-[#555e56]\" data-kid=\"1-2-5-2-1-2-2-2\" data-name=\"cons text\">\n                                On busy weeks, priorities moved faster than decisions were communicated. Better written handoffs would have helped.\n                            </p>\n                        </div>\n                    </div>\n                    <p class=\"mt-5 border-t border-[#ecece6] pt-3 text-[11px] text-[#858a83]\" data-kid=\"1-2-5-2-1-3\" data-name=\"review card date note\">\n                        Demo review · 18 March 2025\n                    </p>\n                </article>\n                <article class=\"rounded-md border border-[#dedfd7] bg-[#fffefa] p-5 sm:p-7\" data-kid=\"1-2-5-2-2\" data-name=\"review card for DemoWorks Digital\">\n                    <div class=\"flex flex-wrap items-center justify-between gap-3 border-b border-[#ecece6] pb-4\" data-kid=\"1-2-5-2-2-1\" data-name=\"review card header\">\n                        <div data-kid=\"1-2-5-2-2-1-1\" data-name=\"review author block\">\n                            <p class=\"text-[11px] text-[#777e76]\" data-kid=\"1-2-5-2-2-1-1-1\" data-name=\"review company label\">\n                                Fictional review · DemoWorks Digital\n                            </p>\n                            <p class=\"mt-1.5 text-[13px] font-medium text-[#39413a]\" data-kid=\"1-2-5-2-2-1-1-2\" data-name=\"review author role\">\n                                Product designer · Current employee\n                            </p>\n                        </div>\n                        <div class=\"inline-flex items-center gap-1.5 text-[14px] font-semibold\" data-kid=\"1-2-5-2-2-1-2\" data-name=\"review card rating value\">\n                            <i class=\"icon-star text-[13px] text-[#66846a]\" data-kid=\"1-2-5-2-2-1-2-1\" data-name=\"star icon\">\n                            </i>\n                            3.7\n                            <span class=\"font-normal text-[#777e76]\" data-kid=\"1-2-5-2-2-1-2-2\" data-name=\"rating scale label\">\n                                / 5\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"mt-5 grid gap-5 sm:grid-cols-2\" data-kid=\"1-2-5-2-2-2\" data-name=\"pros and cons grid\">\n                        <div data-kid=\"1-2-5-2-2-2-1\" data-name=\"review pros block\">\n                            <h3 class=\"text-[12px] font-semibold text-[#46694d]\" data-kid=\"1-2-5-2-2-2-1-1\" data-name=\"pros heading\">\n                                Pros\n                            </h3>\n                            <p class=\"mt-2 text-[13px] leading-[1.7] text-[#555e56]\" data-kid=\"1-2-5-2-2-2-1-2\" data-name=\"pros text\">\n                                The team shares feedback openly, and there are chances to learn across design and engineering.\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-5-2-2-2-2\" data-name=\"review cons block\">\n                            <h3 class=\"text-[12px] font-semibold text-[#626a62]\" data-kid=\"1-2-5-2-2-2-2-1\" data-name=\"cons heading\">\n                                Cons\n                            </h3>\n                            <p class=\"mt-2 text-[13px] leading-[1.7] text-[#555e56]\" data-kid=\"1-2-5-2-2-2-2-2\" data-name=\"cons text\">\n                                Planning can be uneven, and some deadlines feel tight. More time for discovery would improve the pace.\n                            </p>\n                        </div>\n                    </div>\n                    <p class=\"mt-5 border-t border-[#ecece6] pt-3 text-[11px] text-[#858a83]\" data-kid=\"1-2-5-2-2-3\" data-name=\"review card date note\">\n                        Demo review · 6 February 2025\n                    </p>\n                </article>\n            </div>\n        </section>\n        <section aria-labelledby=\"privacy-title\" class=\"border-y border-[#e4e5dd] bg-[#f3f3ed]\" data-kid=\"1-2-6\" data-name=\"privacy and moderation section\" id=\"privacy\">\n            <div class=\"mx-auto grid max-w-[1160px] gap-8 px-5 py-[62px] md:grid-cols-[0.85fr_1.15fr] md:items-start md:px-8 md:py-[82px]\" data-kid=\"1-2-6-1\" data-name=\"privacy section container\">\n                <h2 class=\"max-w-[430px] text-[30px] font-medium leading-tight tracking-[-0.05em] sm:text-[38px]\" data-kid=\"1-2-6-1-1\" data-name=\"privacy section headline\" id=\"privacy-title\">\n                    Your experience. Shared on your terms.\n                </h2>\n                <div class=\"max-w-[630px]\" data-kid=\"1-2-6-1-2\" data-name=\"privacy text block\">\n                    <p class=\"text-[15px] leading-[1.8] text-[#535b54]\" data-kid=\"1-2-6-1-2-1\" data-name=\"privacy explanation text\">\n                        You can submit a review without creating an account. Public reviews don't display the author's identity. Each submission is reviewed by a person against our community guidelines before publication; moderation helps keep contributions respectful, but does not independently verify every statement.\n                    </p>\n                    <div class=\"mt-5 flex flex-wrap gap-x-5 gap-y-2\" data-kid=\"1-2-6-1-2-2\" data-name=\"privacy links row\">\n                        <a class=\"text-[14px] font-medium text-[#315a42] underline decoration-[#a3b6a5] underline-offset-4 hover:text-[#203e2c] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#47745a]\" data-kid=\"1-2-6-1-2-2-1\" data-name=\"community guidelines link\" href=\"/community-guidelines\">\n                            Read Community Guidelines\n                        </a>\n                        <a class=\"text-[14px] font-medium text-[#315a42] underline decoration-[#a3b6a5] underline-offset-4 hover:text-[#203e2c] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#47745a]\" data-kid=\"1-2-6-1-2-2-2\" data-name=\"privacy policy link\" href=\"/privacy\">\n                            Read Privacy Policy\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"final-cta-title\" class=\"px-5 py-[62px] md:px-8 md:py-[88px]\" data-kid=\"1-2-7\" data-name=\"final call to action section\">\n            <div class=\"mx-auto flex max-w-[1160px] flex-col gap-7 rounded-lg bg-[#294c37] px-6 py-9 text-[#f8f7f2] sm:px-10 md:flex-row md:items-end md:justify-between md:px-[54px] md:py-[50px]\" data-kid=\"1-2-7-1\" data-name=\"call to action banner\">\n                <div class=\"max-w-[610px]\" data-kid=\"1-2-7-1-1\" data-name=\"call to action text block\">\n                    <h2 class=\"text-[31px] font-medium leading-[1.15] tracking-[-0.05em] sm:text-[42px]\" data-kid=\"1-2-7-1-1-1\" data-name=\"call to action headline\" id=\"final-cta-title\">\n                        Help someone make a better career decision.\n                    </h2>\n                    <p class=\"mt-4 max-w-[520px] text-[14px] leading-[1.75] text-[#e0e9df] sm:text-[15px]\" data-kid=\"1-2-7-1-1-2\" data-name=\"call to action subheading\">\n                        Your workplace experience could give someone the context they need before accepting their next offer.\n                    </p>\n                </div>\n                <div class=\"flex flex-col items-start gap-4 md:items-end\" data-kid=\"1-2-7-1-2\" data-name=\"call to action buttons row\">\n                    <a class=\"inline-flex min-h-11 items-center justify-center gap-2 rounded-md bg-[#f8f7f2] px-5 text-[14px] font-medium text-[#284a35] hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-white\" data-kid=\"1-2-7-1-2-1\" data-name=\"write review primary button\" href=\"/write-review\">\n                        Write an Anonymous Review\n                        <i class=\"icon-arrow-up-right text-[15px]\" data-kid=\"1-2-7-1-2-1-1\" data-name=\"arrow up-right icon\">\n                        </i>\n                    </a>\n                    <a class=\"text-[13px] font-medium text-[#e8efe6] underline decoration-[#9bb29d] underline-offset-4 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white\" data-kid=\"1-2-7-1-2-2\" data-name=\"find company secondary link\" href=\"/companies\">\n                        Find a Company\n                    </a>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t border-[#e1e2da] bg-[#f2f1eb]\" data-kid=\"1-3\" data-name=\"site footer\">\n        <div class=\"mx-auto max-w-[1160px] px-5 py-8 md:px-8 md:py-10\" data-kid=\"1-3-1\" data-name=\"footer container\">\n            <div class=\"flex flex-col gap-7 md:flex-row md:items-center md:justify-between\" data-kid=\"1-3-1-1\" data-name=\"footer top row\">\n                <a aria-label=\"Worktruth home\" class=\"inline-flex w-fit items-center gap-2.5 text-[19px] font-semibold tracking-[-0.065em] text-[#202620] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#47745a]\" data-kid=\"1-3-1-1-1\" data-name=\"footer logo link\" href=\"/\">\n                    <span class=\"grid size-[23px] place-items-center rounded-[6px] bg-[#315a42] text-[14px] font-medium text-white\" data-kid=\"1-3-1-1-1-1\" data-name=\"footer logo tile\">\n                        w\n                    </span>\n                    <span data-kid=\"1-3-1-1-1-2\" data-name=\"footer logo wordmark\">\n                        worktruth\n                    </span>\n                </a>\n                <nav aria-label=\"Footer navigation\" class=\"flex flex-wrap gap-x-5 gap-y-3 text-[12px] text-[#646b64] sm:gap-x-7 sm:text-[13px]\" data-kid=\"1-3-1-1-2\" data-name=\"footer navigation\">\n                    <a class=\"hover:text-[#315a42] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#47745a]\" data-kid=\"1-3-1-1-2-1\" data-name=\"footer link to companies\" href=\"/companies\">\n                        Explore Companies\n                    </a>\n                    <a class=\"hover:text-[#315a42] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#47745a]\" data-kid=\"1-3-1-1-2-2\" data-name=\"footer link to write review\" href=\"/write-review\">\n                        Write a Review\n                    </a>\n                    <a class=\"hover:text-[#315a42] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#47745a]\" data-kid=\"1-3-1-1-2-3\" data-name=\"footer link to community guidelines\" href=\"/community-guidelines\">\n                        Community Guidelines\n                    </a>\n                    <a class=\"hover:text-[#315a42] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#47745a]\" data-kid=\"1-3-1-1-2-4\" data-name=\"footer link to privacy policy\" href=\"/privacy\">\n                        Privacy Policy\n                    </a>\n                    <a class=\"hover:text-[#315a42] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#47745a]\" data-kid=\"1-3-1-1-2-5\" data-name=\"footer link to terms\" href=\"/terms\">\n                        Terms of Service\n                    </a>\n                    <a class=\"hover:text-[#315a42] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#47745a]\" data-kid=\"1-3-1-1-2-6\" data-name=\"footer link to contact\" href=\"/contact\">\n                        Contact\n                    </a>\n                </nav>\n            </div>\n            <div class=\"mt-7 flex flex-col gap-2 border-t border-[#dedfd7] pt-4 text-[11px] leading-5 text-[#7c8179] sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-3-1-2\" data-name=\"footer bottom row\">\n                <p data-kid=\"1-3-1-2-1\" data-name=\"footer disclaimer text\">\n                    Worktruth helps people compare workplace experiences with care.\n                </p>\n                <p data-kid=\"1-3-1-2-2\" data-name=\"footer demo data notice\">\n                    All company and review content shown here is fictional demo data.\n                </p>\n            </div>\n        </div>\n    </footer>\n</div>\n",
      "comments": [],
      "created": "2026-10-10T20:46:22.267025+00:00",
      "modified": "2026-10-10T20:47:15.889245+00:00",
      "id": "var_803c566e987c",
      "contentHeight": 4054
    },
    "var_78a8669998bb": {
      "type": "variant",
      "label": "Worktruth — Review document",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4140,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap'); @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"min-h-screen overflow-x-clip bg-[#f8f8f5] font-sans text-[#191d19] antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:Geist,Arial,sans-serif\">\n    <header class=\"mx-auto max-w-[1240px] px-8 max-md:px-5\" data-kid=\"1-1\" data-name=\"site header wrapper\">\n        <div class=\"flex h-[76px] items-center justify-between border-b border-[#dfe2db]\" data-kid=\"1-1-1\" data-name=\"header navigation bar\">\n            <a aria-label=\"Worktruth home\" class=\"flex items-center gap-2.5 text-[20px] font-semibold tracking-[-.7px] text-[#191d19] no-underline\" data-kid=\"1-1-1-1\" data-name=\"site logo link\" href=\"/\">\n                <span class=\"flex size-8 items-center justify-center rounded-[8px] bg-[#286144] text-[16px] font-semibold text-white\" data-kid=\"1-1-1-1-1\" data-name=\"logo mark badge\">\n                    w.\n                </span>\n                Worktruth\n            </a>\n            <nav aria-label=\"Main navigation\" class=\"flex items-center gap-8 text-[14px] text-[#515a52] max-md:hidden\" data-kid=\"1-1-1-2\" data-name=\"desktop main navigation\">\n                <a class=\"no-underline hover:text-[#286144] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#286144]\" data-kid=\"1-1-1-2-1\" data-name=\"Explore Companies nav link\" href=\"/companies\">\n                    Explore Companies\n                </a>\n                <a class=\"no-underline hover:text-[#286144] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#286144]\" data-kid=\"1-1-1-2-2\" data-name=\"How It Works nav link\" href=\"#how-it-works\">\n                    How It Works\n                </a>\n                <a class=\"no-underline hover:text-[#286144] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#286144]\" data-kid=\"1-1-1-2-3\" data-name=\"Community Guidelines nav link\" href=\"/community-guidelines\">\n                    Community Guidelines\n                </a>\n            </nav>\n            <a class=\"inline-flex h-10 items-center justify-center rounded-[7px] bg-[#286144] px-4 text-[13px] font-medium text-white no-underline hover:bg-[#1f4e35] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#286144] max-md:hidden\" data-kid=\"1-1-1-3\" data-name=\"Write a Review call-to-action button\" href=\"/write-review\">\n                Write a Review\n                <span aria-hidden=\"true\" class=\"ml-2 text-[16px]\" data-kid=\"1-1-1-3-1\" data-name=\"external arrow glyph\">\n                    ↗\n                </span>\n            </a>\n            <details class=\"relative hidden max-md:block\" data-kid=\"1-1-1-4\" data-name=\"mobile menu dropdown\">\n                <summary aria-label=\"Open navigation menu\" class=\"flex size-10 cursor-pointer list-none items-center justify-center rounded-md border border-[#dfe2db] text-[19px] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#286144]\" data-kid=\"1-1-1-4-1\" data-name=\"mobile menu hamburger button\">\n                    <i aria-hidden=\"true\" class=\"icon-menu\" data-kid=\"1-1-1-4-1-1\" data-name=\"hamburger menu icon\">\n                    </i>\n                </summary>\n                <nav aria-label=\"Mobile navigation\" class=\"absolute right-0 top-12 z-10 flex min-w-[226px] flex-col gap-1 rounded-lg border border-[#dfe2db] bg-[#fffefa] p-2 text-[14px] shadow-lg\" data-kid=\"1-1-1-4-2\" data-name=\"mobile navigation menu\">\n                    <a class=\"rounded px-3 py-2.5 text-[#191d19] no-underline hover:bg-[#f1f2ed]\" data-kid=\"1-1-1-4-2-1\" data-name=\"mobile Explore Companies link\" href=\"/companies\">\n                        Explore Companies\n                    </a>\n                    <a class=\"rounded px-3 py-2.5 text-[#191d19] no-underline hover:bg-[#f1f2ed]\" data-kid=\"1-1-1-4-2-2\" data-name=\"mobile How It Works link\" href=\"#how-it-works\">\n                        How It Works\n                    </a>\n                    <a class=\"rounded px-3 py-2.5 text-[#191d19] no-underline hover:bg-[#f1f2ed]\" data-kid=\"1-1-1-4-2-3\" data-name=\"mobile Community Guidelines link\" href=\"/community-guidelines\">\n                        Community Guidelines\n                    </a>\n                    <a class=\"rounded bg-[#286144] px-3 py-2.5 font-medium text-white no-underline\" data-kid=\"1-1-1-4-2-4\" data-name=\"mobile Write a Review link\" href=\"/write-review\">\n                        Write a Review\n                    </a>\n                </nav>\n            </details>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content region\">\n        <section aria-labelledby=\"hero-title\" class=\"mx-auto grid max-w-[1240px] grid-cols-[1fr_.94fr] items-center gap-[68px] px-8 pb-[76px] pt-[74px] max-lg:gap-10 max-md:grid-cols-1 max-md:gap-10 max-md:px-5 max-md:pb-12 max-md:pt-11\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div class=\"max-w-[550px]\" data-kid=\"1-2-1-1\" data-name=\"hero text column\">\n                <p class=\"mb-5 text-[13px] font-medium text-[#536056]\" data-kid=\"1-2-1-1-1\" data-name=\"hero eyebrow tagline\">\n                    A clearer view of work in Nigerian tech\n                </p>\n                <h1 class=\"max-w-[560px] text-[56px] font-medium leading-[1.07] tracking-[-2.8px] text-[#191d19] max-md:text-[42px] max-md:leading-[1.1] max-md:tracking-[-1.8px]\" data-kid=\"1-2-1-1-2\" data-name=\"hero headline\" id=\"hero-title\">\n                    Know what it’s really like to work there.\n                </h1>\n                <p class=\"mt-6 max-w-[510px] text-[17px] leading-[1.72] text-[#5d665e] max-md:text-[16px]\" data-kid=\"1-2-1-1-3\" data-name=\"hero description paragraph\">\n                    Honest workplace experiences from people who have been there. Research Nigerian tech companies before you make your next career move.\n                </p>\n                <form action=\"/companies\" class=\"mt-8 flex min-h-[58px] max-w-[535px] items-center rounded-[8px] border border-[#c9cec7] bg-[#fffefa] p-1.5 shadow-[0_2px_8px_rgba(27,40,29,0.04)] focus-within:border-[#286144] focus-within:ring-2 focus-within:ring-[#286144]/15\" data-kid=\"1-2-1-1-4\" data-name=\"company search form\" method=\"get\">\n                    <label class=\"sr-only\" data-kid=\"1-2-1-1-4-1\" data-name=\"search input label\" for=\"company-search\">\n                        Search companies in Nigeria\n                    </label>\n                    <i aria-hidden=\"true\" class=\"icon-search ml-3 text-[18px] text-[#657068]\" data-kid=\"1-2-1-1-4-2\" data-name=\"search magnifier icon\">\n                    </i>\n                    <input class=\"min-w-0 grow border-0 bg-transparent px-3 py-3 text-[14px] text-[#191d19] outline-none placeholder:text-[#838b84]\" data-kid=\"1-2-1-1-4-3\" data-name=\"company search input field\" id=\"company-search\" name=\"q\" placeholder=\"Search companies in Nigeria...\" type=\"search\"/>\n                    <button class=\"inline-flex h-[43px] shrink-0 items-center justify-center gap-2 rounded-[6px] bg-[#286144] px-4 text-[13px] font-medium text-white hover:bg-[#1f4e35] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#286144] max-[430px]:px-3\" data-kid=\"1-2-1-1-4-4\" data-name=\"search submit button\" type=\"submit\">\n                        Search\n                        <span aria-hidden=\"true\" class=\"text-[17px]\" data-kid=\"1-2-1-1-4-4-1\" data-name=\"external arrow glyph\">\n                            ↗\n                        </span>\n                    </button>\n                </form>\n                <div class=\"mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-[13px]\" data-kid=\"1-2-1-1-5\" data-name=\"hero secondary actions row\">\n                    <a class=\"font-medium text-[#286144] underline decoration-[#9bb6a0] underline-offset-4 hover:text-[#1f4e35] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#286144]\" data-kid=\"1-2-1-1-5-1\" data-name=\"Share Your Experience link\" href=\"/write-review\">\n                        Share Your Experience\n                        <span aria-hidden=\"true\" data-kid=\"1-2-1-1-5-1-1\" data-name=\"external arrow glyph\">\n                            ↗\n                        </span>\n                    </a>\n                    <span class=\"text-[#727b73]\" data-kid=\"1-2-1-1-5-2\" data-name=\"anonymous sharing note\">\n                        Read anonymously. Share without an account.\n                    </span>\n                </div>\n            </div>\n            <article aria-labelledby=\"sample-review-title\" class=\"mx-auto w-full max-w-[525px] border border-[#d8dcd5] bg-[#fffefa] p-7 shadow-[0_10px_30px_rgba(31,46,33,0.045)] max-md:p-5\" data-kid=\"1-2-1-2\" data-name=\"featured sample review card\">\n                <header class=\"border-b border-[#e2e5df] pb-5\" data-kid=\"1-2-1-2-1\" data-name=\"sample review card header\">\n                    <p class=\"text-[12px] font-medium leading-5 text-[#286144]\" data-kid=\"1-2-1-2-1-1\" data-name=\"sample review label\">\n                        Fictional example · Sample review copy\n                    </p>\n                    <div class=\"mt-2 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2\" data-kid=\"1-2-1-2-1-2\" data-name=\"sample review title and rating row\">\n                        <div data-kid=\"1-2-1-2-1-2-1\" data-name=\"company name and location block\">\n                            <h2 class=\"text-[21px] font-semibold tracking-[-.65px]\" data-kid=\"1-2-1-2-1-2-1-1\" data-name=\"sample review company title\" id=\"sample-review-title\">\n                                Baobab Circuit\n                            </h2>\n                            <p class=\"mt-1 text-[13px] text-[#727a73]\" data-kid=\"1-2-1-2-1-2-1-2\" data-name=\"company industry and location text\">\n                                Illustrative software company · Lagos\n                            </p>\n                        </div>\n                        <div class=\"text-[13px] text-[#626b63]\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"company rating summary\">\n                            <span class=\"font-semibold text-[#333b34]\" data-kid=\"1-2-1-2-1-2-2-1\" data-name=\"rating number\">\n                                4.1\n                            </span>\n                            <span aria-label=\"stars\" class=\"text-[#a87932]\" data-kid=\"1-2-1-2-1-2-2-2\" data-name=\"star icon\">\n                                ★\n                            </span>\n                            <span class=\"ml-1.5\" data-kid=\"1-2-1-2-1-2-2-3\" data-name=\"review count text\">\n                                8 sample reviews\n                            </span>\n                        </div>\n                    </div>\n                </header>\n                <div class=\"pt-5\" data-kid=\"1-2-1-2-2\" data-name=\"sample review body\">\n                    <div class=\"flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1\" data-kid=\"1-2-1-2-2-1\" data-name=\"reviewer role and status row\">\n                        <h3 class=\"text-[15px] font-semibold\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"reviewer role heading\">\n                            Product designer\n                        </h3>\n                        <p class=\"text-[12px] text-[#727a73]\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"reviewer status text\">\n                            Former employee · Fictional review\n                        </p>\n                    </div>\n                    <p class=\"mt-3 text-[14px] leading-[1.75] text-[#454d46]\" data-kid=\"1-2-1-2-2-2\" data-name=\"review quote text\">\n                        “I had room to shape features early, and the team made time for thoughtful design critiques. Priorities could shift mid-sprint, so I learned to ask for trade-offs sooner.”\n                    </p>\n                    <div class=\"mt-5 grid grid-cols-2 gap-6 border-t border-[#e2e5df] pt-4 max-sm:grid-cols-1 max-sm:gap-4\" data-kid=\"1-2-1-2-2-3\" data-name=\"pros and cons columns\">\n                        <div data-kid=\"1-2-1-2-2-3-1\" data-name=\"pros column\">\n                            <h4 class=\"text-[12px] font-semibold uppercase tracking-[.09em] text-[#286144]\" data-kid=\"1-2-1-2-2-3-1-1\" data-name=\"pros heading\">\n                                Pros\n                            </h4>\n                            <p class=\"mt-2 text-[13px] leading-[1.65] text-[#454d46]\" data-kid=\"1-2-1-2-2-3-1-2\" data-name=\"pros description\">\n                                Room to own product details; peer feedback was considered.\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-1-2-2-3-2\" data-name=\"cons column\">\n                            <h4 class=\"text-[12px] font-semibold uppercase tracking-[.09em] text-[#717971]\" data-kid=\"1-2-1-2-2-3-2-1\" data-name=\"cons heading\">\n                                Cons\n                            </h4>\n                            <p class=\"mt-2 text-[13px] leading-[1.65] text-[#454d46]\" data-kid=\"1-2-1-2-2-3-2-2\" data-name=\"cons description\">\n                                Scope changed quickly; sprint priorities were not always clear.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </article>\n        </section>\n        <section aria-labelledby=\"context-title\" class=\"border-y border-[#e1e3dc] bg-[#f0f2ec]\" data-kid=\"1-2-2\" data-name=\"context section\">\n            <div class=\"mx-auto max-w-[1240px] px-8 py-[62px] max-md:px-5 max-md:py-11\" data-kid=\"1-2-2-1\" data-name=\"context section container\">\n                <h2 class=\"max-w-[660px] text-[34px] font-medium leading-[1.2] tracking-[-1.3px] max-md:text-[29px]\" data-kid=\"1-2-2-1-1\" data-name=\"context section headline\" id=\"context-title\">\n                    Make career decisions with more context.\n                </h2>\n                <div class=\"mt-8 grid grid-cols-3 border-y border-[#d8dcd5] max-md:grid-cols-1\" data-kid=\"1-2-2-1-2\" data-name=\"context feature grid\">\n                    <article class=\"py-6 pr-8 max-md:border-b max-md:border-[#d8dcd5] max-md:pr-0\" data-kid=\"1-2-2-1-2-1\" data-name=\"real experiences feature card\">\n                        <i aria-hidden=\"true\" class=\"icon-message-square-more text-[21px] text-[#286144]\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"message square icon\">\n                        </i>\n                        <h3 class=\"mt-4 text-[16px] font-semibold\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"feature card title\">\n                            Real Workplace Experiences\n                        </h3>\n                        <p class=\"mt-2 max-w-[310px] text-[14px] leading-[1.65] text-[#606961]\" data-kid=\"1-2-2-1-2-1-3\" data-name=\"feature card description\">\n                            Learn from current and former employees who have been there.\n                        </p>\n                    </article>\n                    <article class=\"border-l border-[#d8dcd5] px-8 py-6 max-md:border-b max-md:border-l-0 max-md:px-0\" data-kid=\"1-2-2-1-2-2\" data-name=\"anonymous by design feature card\">\n                        <i aria-hidden=\"true\" class=\"icon-eye-off text-[21px] text-[#286144]\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"eye-off icon\">\n                        </i>\n                        <h3 class=\"mt-4 text-[16px] font-semibold\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"feature card title\">\n                            Anonymous by Design\n                        </h3>\n                        <p class=\"mt-2 max-w-[310px] text-[14px] leading-[1.65] text-[#606961]\" data-kid=\"1-2-2-1-2-2-3\" data-name=\"feature card description\">\n                            Share without creating an account. Your identity is not shown on public reviews.\n                        </p>\n                    </article>\n                    <article class=\"border-l border-[#d8dcd5] py-6 pl-8 max-md:border-l-0 max-md:pl-0\" data-kid=\"1-2-2-1-2-3\" data-name=\"human-reviewed feature card\">\n                        <i aria-hidden=\"true\" class=\"icon-clipboard-check text-[21px] text-[#286144]\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"clipboard check icon\">\n                        </i>\n                        <h3 class=\"mt-4 text-[16px] font-semibold\" data-kid=\"1-2-2-1-2-3-2\" data-name=\"feature card title\">\n                            Human-Reviewed Feedback\n                        </h3>\n                        <p class=\"mt-2 max-w-[310px] text-[14px] leading-[1.65] text-[#606961]\" data-kid=\"1-2-2-1-2-3-3\" data-name=\"feature card description\">\n                            Every review is moderated by a person before publication.\n                        </p>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"how-title\" class=\"mx-auto max-w-[1240px] px-8 py-[72px] max-md:px-5 max-md:py-12\" data-kid=\"1-2-3\" data-name=\"how it works section\" id=\"how-it-works\">\n            <div data-kid=\"1-2-3-1\" data-name=\"how it works heading block\">\n                <h2 class=\"text-[34px] font-medium tracking-[-1.3px] max-md:text-[29px]\" data-kid=\"1-2-3-1-1\" data-name=\"how it works heading\" id=\"how-title\">\n                    How it works\n                </h2>\n                <p class=\"mt-3 text-[15px] leading-[1.65] text-[#626b63]\" data-kid=\"1-2-3-1-2\" data-name=\"how it works subtitle\">\n                    Start with the company on your mind. Leave with a fuller picture.\n                </p>\n            </div>\n            <ol class=\"mt-8 grid grid-cols-3 border-t border-[#d8dcd5] max-md:grid-cols-1 max-md:border-t-0\" data-kid=\"1-2-3-2\" data-name=\"steps list container\">\n                <li class=\"border-r border-[#d8dcd5] py-6 pr-9 max-md:border-r-0 max-md:border-b max-md:py-5 max-md:pr-0\" data-kid=\"1-2-3-2-1\" data-name=\"step one item\">\n                    <span class=\"flex size-8 items-center justify-center rounded-full border border-[#b8c7ba] text-[13px] font-medium text-[#286144]\" data-kid=\"1-2-3-2-1-1\" data-name=\"step number badge\">\n                        1\n                    </span>\n                    <h3 class=\"mt-4 text-[17px] font-semibold\" data-kid=\"1-2-3-2-1-2\" data-name=\"step title\">\n                        Find a company.\n                    </h3>\n                    <p class=\"mt-2 max-w-[290px] text-[14px] leading-[1.65] text-[#626b63]\" data-kid=\"1-2-3-2-1-3\" data-name=\"step description\">\n                        Search the Nigerian tech companies you’re considering.\n                    </p>\n                </li>\n                <li class=\"border-r border-[#d8dcd5] px-9 py-6 max-md:border-r-0 max-md:border-b max-md:px-0 max-md:py-5\" data-kid=\"1-2-3-2-2\" data-name=\"step two item\">\n                    <span class=\"flex size-8 items-center justify-center rounded-full border border-[#b8c7ba] text-[13px] font-medium text-[#286144]\" data-kid=\"1-2-3-2-2-1\" data-name=\"step number badge\">\n                        2\n                    </span>\n                    <h3 class=\"mt-4 text-[17px] font-semibold\" data-kid=\"1-2-3-2-2-2\" data-name=\"step title\">\n                        Read employee experiences.\n                    </h3>\n                    <p class=\"mt-2 max-w-[290px] text-[14px] leading-[1.65] text-[#626b63]\" data-kid=\"1-2-3-2-2-3\" data-name=\"step description\">\n                        Look beyond the score at the details people share.\n                    </p>\n                </li>\n                <li class=\"py-6 pl-9 max-md:py-5 max-md:pl-0\" data-kid=\"1-2-3-2-3\" data-name=\"step three item\">\n                    <span class=\"flex size-8 items-center justify-center rounded-full border border-[#b8c7ba] text-[13px] font-medium text-[#286144]\" data-kid=\"1-2-3-2-3-1\" data-name=\"step number badge\">\n                        3\n                    </span>\n                    <h3 class=\"mt-4 text-[17px] font-semibold\" data-kid=\"1-2-3-2-3-2\" data-name=\"step title\">\n                        Share your own experience anonymously.\n                    </h3>\n                    <p class=\"mt-2 max-w-[290px] text-[14px] leading-[1.65] text-[#626b63]\" data-kid=\"1-2-3-2-3-3\" data-name=\"step description\">\n                        Add thoughtful context without creating an account.\n                    </p>\n                </li>\n            </ol>\n        </section>\n        <section aria-labelledby=\"companies-title\" class=\"border-y border-[#e1e3dc] bg-[#f0f2ec]\" data-kid=\"1-2-4\" data-name=\"companies showcase section\">\n            <div class=\"mx-auto max-w-[1240px] px-8 py-[72px] max-md:px-5 max-md:py-12\" data-kid=\"1-2-4-1\" data-name=\"companies section container\">\n                <div class=\"flex items-end justify-between gap-8 max-md:flex-col max-md:items-start max-md:gap-3\" data-kid=\"1-2-4-1-1\" data-name=\"section heading and link row\">\n                    <div data-kid=\"1-2-4-1-1-1\" data-name=\"heading block\">\n                        <h2 class=\"max-w-[710px] text-[34px] font-medium leading-[1.2] tracking-[-1.3px] max-md:text-[29px]\" data-kid=\"1-2-4-1-1-1-1\" data-name=\"section heading\" id=\"compa