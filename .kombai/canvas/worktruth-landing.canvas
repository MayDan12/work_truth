      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;450;500;550;600;650;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.wt-page{--paper:#f8f7f2;--surface:#fdfcf9;--ink:#20231f;--muted:#686e67;--line:#dedfd8;--green:#315e46;--green-dark:#254b38;--green-soft:#e8eee7;--white:#fff;--content:1160px;background:var(--paper);color:var(--ink);font-family:'Geist',Arial,sans-serif;font-size:15px;line-height:1.55;min-height:100vh;overflow-x:clip}.wt-page *{box-sizing:border-box}.wt-page a{color:inherit;text-decoration:none}.wt-page a:hover{text-decoration:underline;text-underline-offset:4px}.wt-page button,.wt-page a,.wt-page input,.wt-page summary{font:inherit}.wt-page a:focus-visible,.wt-page button:focus-visible,.wt-page input:focus-visible,.wt-page summary:focus-visible{outline:3px solid #6f9a79;outline-offset:3px}.wt-shell{max-width:var(--content);width:calc(100% - 64px);margin:0 auto}.wt-header{height:82px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}.wt-brand{display:inline-flex;align-items:center;gap:10px;font-size:20px;font-weight:650;letter-spacing:-.055em}.wt-mark{width:25px;height:25px;border:1.5px solid var(--green);border-radius:50%;display:grid;place-items:center;color:var(--green);font-size:14px;line-height:1}.wt-nav{display:flex;align-items:center;gap:33px;color:#50564f;font-size:14px}.wt-nav a,.wt-footer-links a{transition:color .18s ease}.wt-nav a:hover,.wt-footer-links a:hover{color:var(--green)}.wt-header-cta{background:var(--green);color:white!important;border-radius:5px;padding:11px 17px;font-weight:550;font-size:14px;transition:background .18s ease}.wt-header-cta:hover{background:var(--green-dark);text-decoration:none!important}.wt-mobile-menu{display:none;position:relative}.wt-mobile-menu summary{list-style:none;cursor:pointer;border:1px solid var(--line);border-radius:5px;padding:8px 11px;color:var(--ink)}.wt-mobile-menu summary::-webkit-details-marker{display:none}.wt-mobile-links{position:absolute;z-index:3;right:0;top:45px;width:220px;padding:15px;background:var(--surface);border:1px solid var(--line);box-shadow:0 14px 34px #171e151c;display:grid;gap:13px;border-radius:7px}.wt-hero{padding:90px 0 56px}.wt-hero-copy{max-width:790px}.wt-hero h1{font-size:clamp(43px,5.2vw,67px);line-height:1.04;letter-spacing:-.075em;font-weight:550;margin:0 0 24px;max-width:750px}.wt-hero-copy>p{font-size:18px;line-height:1.62;color:#596059;max-width:655px;margin:0}.wt-search-form{display:flex;align-items:center;gap:10px;max-width:800px;margin:33px 0 17px;padding:7px;background:var(--surface);border:1px solid #c9ccc4;border-radius:7px;box-shadow:0 5px 17px #1a24170a}.wt-search-icon{color:#737970;font-size:18px;padding-left:11px;display:flex}.wt-search-form input{background:transparent;border:0;min-width:0;flex:1;color:var(--ink);font-size:15px;padding:10px 2px}.wt-search-form input::placeholder{color:#81867f}.wt-search-form input:focus{outline:none}.wt-search-form:focus-within{outline:3px solid #6f9a794d;border-color:var(--green)}.wt-search-form button{border:0;border-radius:4px;background:var(--green);color:white;padding:11px 18px;font-weight:550;cursor:pointer;transition:background .18s ease}.wt-search-form button:hover{background:var(--green-dark)}.wt-hero-actions{display:flex;align-items:center;gap:18px;font-size:14px}.wt-secondary-link{font-weight:550;color:var(--green)!important}.wt-trust-note{display:inline-flex;align-items:center;gap:7px;color:var(--muted);font-size:13px}.wt-trust-note .icon{font-size:14px;color:var(--green)}.wt-example{max-width:940px;margin-top:52px;background:var(--surface);border:1px solid var(--line);border-radius:7px;padding:25px 29px 24px}.wt-example-head{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;padding-bottom:19px;border-bottom:1px solid var(--line)}.wt-company-title{display:flex;align-items:baseline;gap:11px;flex-wrap:wrap}.wt-company-title h2{font-size:21px;line-height:1.2;letter-spacing:-.045em;font-weight:600;margin:0}.wt-demo-label{color:#647066;font-size:12px;font-weight:500}.wt-company-meta{color:var(--muted);font-size:13px;margin-top:6px}.wt-rating{white-space:nowrap;display:flex;align-items:center;gap:8px;font-size:14px}.wt-rating strong{font-size:23px;letter-spacing:-.05em;font-weight:600}.wt-rating .icon{font-size:15px;color:#a17c31}.wt-rating span:last-child{font-size:13px;color:var(--muted)}.wt-example-body{padding-top:18px;display:grid;grid-template-columns:170px minmax(0,1fr);gap:28px}.wt-review-kicker{font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:#777c74;font-weight:550}.wt-example-review h3{font-size:17px;line-height:1.35;letter-spacing:-.02em;margin:0 0 8px;font-weight:550}.wt-example-review p{color:#555c55;font-size:14px;line-height:1.65;margin:0;max-width:660px}.wt-example-review .wt-example-pros{margin-top:11px;color:#555c55;font-size:13px}.wt-example-pros b{color:var(--green);font-weight:600}.wt-section{padding:76px 0}.wt-section-rule{border-top:1px solid var(--line)}.wt-section-heading{font-size:34px;line-height:1.15;letter-spacing:-.065em;font-weight:550;margin:0;max-width:650px}.wt-section-intro{margin:13px 0 0;color:var(--muted);max-width:570px;font-size:15px}.wt-values{padding-top:75px;padding-bottom:78px}.wt-value-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:36px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.wt-value{padding:25px 29px 25px 0;min-height:148px}.wt-value+.wt-value{border-left:1px solid var(--line);padding-left:28px}.wt-value .icon{font-size:21px;color:var(--green)}.wt-value h3{font-size:16px;letter-spacing:-.025em;margin:17px 0 7px;font-weight:600}.wt-value p{font-size:14px;line-height:1.62;color:var(--muted);margin:0;max-width:310px}.wt-how{background:#efeee8;padding:69px 0 73px}.wt-how .wt-section-heading{font-size:31px}.wt-steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:37px}.wt-step{position:relative;padding:0 35px 0 0}.wt-step+.wt-step{padding-left:28px;border-left:1px solid #d2d4cc}.wt-step-num{font-size:12px;color:var(--green);font-weight:600;letter-spacing:.04em}.wt-step h3{margin:12px 0 6px;font-size:17px;font-weight:600;letter-spacing:-.03em}.wt-step p{color:#676d65;font-size:14px;line-height:1.62;margin:0;max-width:280px}.wt-discovery{padding:85px 0 88px}.wt-discovery-head{display:flex;justify-content:space-between;align-items:end;gap:30px}.wt-discovery-head .wt-section-heading{max-width:580px}.wt-sample-note{color:#737a72;font-size:13px;margin:15px 0 0}.wt-text-link{color:var(--green)!important;font-size:14px;font-weight:600;white-space:nowrap}.wt-company-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 29px;margin-top:35px;border-top:1px solid var(--line)}.wt-company-card{border-bottom:1px solid var(--line);padding:22px 0 23px;display:flex;flex-direction:column;min-height:146px}.wt-company-card h3{margin:0 0 5px;font-size:17px;font-weight:600;letter-spacing:-.03em}.wt-company-card .wt-company-meta{margin:0 0 14px;font-size:13px}.wt-company-score{display:flex;align-items:center;gap:7px;font-size:13px;color:#535b52;margin-top:auto}.wt-company-score .icon{font-size:14px;color:#a17c31}.wt-company-score strong{color:var(--ink);font-size:16px;font-weight:600}.wt-company-score span{color:var(--muted)}.wt-no-reviews{font-size:13px;color:var(--muted);margin-top:auto}.wt-summary{display:block;color:#747970;font-size:13px;margin-top:7px}.wt-review-section{background:#f0efe9;padding:77px 0 83px}.wt-review-section .wt-section-heading{max-width:720px}.wt-review-grid{display:grid;grid-template-columns:1.12fr .88fr;gap:23px;margin-top:34px}.wt-review-card{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:25px 26px 27px}.wt-review-card h3{font-size:18px;font-weight:550;letter-spacing:-.035em;margin:18px 0 6px}.wt-review-meta{font-size:13px;color:var(--muted);display:flex;align-items:center;gap:8px;flex-wrap:wrap}.wt-review-meta .dot{width:3px;height:3px;border-radius:50%;background:#969a92}.wt-review-rating{margin-top:15px;font-size:13px;display:flex;align-items:center;gap:7px}.wt-review-rating .icon{color:#a17c31}.wt-review-rating strong{font-weight:600}.wt-review-date{color:var(--muted);margin-left:7px}.wt-pros-cons{display:grid;grid-template-columns:1fr 1fr;gap:21px;margin-top:22px;padding-top:18px;border-top:1px solid var(--line)}.wt-pros-cons h4{font-size:12px;color:#536657;text-transform:uppercase;letter-spacing:.045em;margin:0 0 7px;font-weight:600}.wt-pros-cons p{font-size:14px;line-height:1.6;color:#555c55;margin:0}.wt-pros-cons .wt-cons h4{color:#69655d}.wt-privacy{padding:86px 0 91px}.wt-privacy-layout{display:grid;grid-template-columns:.9fr 1.1fr;gap:88px;align-items:start}.wt-privacy-layout .wt-section-heading{max-width:440px}.wt-privacy-copy{padding-top:3px;max-width:570px}.wt-privacy-copy p{color:#535a53;font-size:15px;line-height:1.75;margin:0 0 15px}.wt-privacy-links{display:flex;gap:20px;margin-top:22px;color:var(--green);font-size:14px;font-weight:550}.wt-cta-band{background:var(--green-dark);color:#f7f7f1;padding:58px 0 59px}.wt-cta-inner{display:flex;align-items:center;justify-content:space-between;gap:40px}.wt-cta-copy{max-width:620px}.wt-cta-copy h2{font-size:36px;line-height:1.15;letter-spacing:-.06em;font-weight:550;margin:0 0 10px;max-width:550px}.wt-cta-copy p{font-size:15px;line-height:1.65;color:#e3e9e2;margin:0;max-width:570px}.wt-cta-actions{display:flex;align-items:center;gap:19px;white-space:nowrap}.wt-cta-primary{background:var(--paper);color:var(--green-dark)!important;border-radius:4px;padding:12px 17px;font-size:14px;font-weight:600;transition:background .18s ease}.wt-cta-primary:hover{background:#e9ede7;text-decoration:none!important}.wt-cta-secondary{font-size:14px;color:#f4f6f2!important;font-weight:500}.wt-footer{padding:31px 0 36px}.wt-footer-top{display:flex;align-items:center;justify-content:space-between;gap:30px;padding-bottom:24px;border-bottom:1px solid var(--line)}.wt-footer .wt-brand{font-size:18px}.wt-footer-links{display:flex;gap:23px;align-items:center;flex-wrap:wrap;color:#646a63;font-size:13px}.wt-footer-bottom{display:flex;justify-content:space-between;align-items:center;padding-top:18px;color:#7a8078;font-size:12px}.wt-footer-bottom p{margin:0}.wt-demo-disclaimer{font-size:12px;color:#72796f;margin-top:14px}\n@media(max-width:800px){.wt-shell{width:calc(100% - 40px)}.wt-header{height:70px}.wt-nav{gap:17px;font-size:13px}.wt-header-cta{padding:9px 12px}.wt-hero{padding:70px 0 48px}.wt-hero h1{font-size:clamp(43px,7.5vw,60px)}.wt-example{margin-top:43px}.wt-section{padding:62px 0}.wt-discovery{padding:69px 0}.wt-review-section{padding:63px 0}.wt-privacy{padding:68px 0}.wt-privacy-layout{gap:42px}.wt-cta-inner{align-items:flex-start;flex-direction:column;gap:25px}.wt-footer-top{align-items:flex-start;flex-direction:column}}\n@media(max-width:620px){.wt-shell{width:calc(100% - 36px)}.wt-nav{display:none}.wt-mobile-menu{display:block}.wt-header-cta{margin-left:auto;margin-right:10px}.wt-brand{font-size:19px}.wt-hero{padding:55px 0 40px}.wt-hero h1{font-size:43px;line-height:1.06;max-width:530px;letter-spacing:-.07em;margin-bottom:17px}.wt-hero-copy>p{font-size:16px;line-height:1.6}.wt-search-form{gap:6px;margin:25px 0 15px;padding:5px}.wt-search-icon{padding-left:8px}.wt-search-form input{font-size:14px;padding:10px 0}.wt-search-form button{padding:10px 12px;font-size:13px;white-space:nowrap}.wt-hero-actions{align-items:flex-start;flex-direction:column;gap:10px}.wt-example{margin-top:33px;padding:19px 17px}.wt-example-head{flex-direction:column;gap:14px}.wt-company-title h2{font-size:19px}.wt-example-body{grid-template-columns:1fr;gap:10px;padding-top:15px}.wt-rating strong{font-size:21px}.wt-section-heading{font-size:29px}.wt-values{padding-top:58px;padding-bottom:60px}.wt-value-grid{grid-template-columns:1fr;margin-top:23px}.wt-value{min-height:0;padding:20px 0}.wt-value+.wt-value{border-left:0;border-top:1px solid var(--line);padding-left:0}.wt-value .icon{font-size:19px}.wt-value h3{margin:10px 0 4px}.wt-how{padding:57px 0 61px}.wt-steps{grid-template-columns:1fr;margin-top:24px}.wt-step{padding:0 0 22px 0;display:grid;grid-template-columns:30px 1fr;column-gap:8px}.wt-step+.wt-step{padding:20px 0 22px;border-left:0;border-top:1px solid #d2d4cc}.wt-step-num{grid-row:span 2;padding-top:2px}.wt-step h3{margin:0 0 4px}.wt-step p{max-width:380px}.wt-discovery-head{align-items:flex-start;flex-direction:column;gap:15px}.wt-company-grid{grid-template-columns:1fr;margin-top:24px}.wt-company-card{min-height:130px;padding:18px 0}.wt-review-grid{grid-template-columns:1fr;gap:14px;margin-top:25px}.wt-review-card{padding:21px 18px}.wt-pros-cons{gap:15px}.wt-review-section{padding:58px 0}.wt-privacy-layout{grid-template-columns:1fr;gap:19px}.wt-privacy{padding:59px 0 63px}.wt-privacy-copy p{font-size:14px}.wt-cta-band{padding:44px 0}.wt-cta-copy h2{font-size:31px}.wt-cta-actions{align-items:flex-start;flex-direction:column;gap:12px}.wt-footer{padding:27px 0}.wt-footer-links{gap:13px 18px}.wt-footer-bottom{align-items:flex-start;flex-direction:column;gap:7px}.wt-demo-disclaimer{font-size:11px}}\n</style>\n<div class=\"wt-page\" data-kid=\"1\" data-name=\"page wrapper applying theme styles\">\n    <header class=\"wt-shell wt-header\" data-kid=\"1-1\" data-name=\"site masthead header\">\n        <a aria-label=\"Worktruth home\" class=\"wt-brand\" data-kid=\"1-1-1\" data-name=\"brand logo link to home\" href=\"/\">\n            <span aria-hidden=\"true\" class=\"wt-mark\" data-kid=\"1-1-1-1\" data-name=\"brand monogram inside circle\">\n                w\n            </span>\n            <span data-kid=\"1-1-1-2\" data-name=\"brand name text\">\n                Worktruth\n            </span>\n        </a>\n        <nav aria-label=\"Main navigation\" class=\"wt-nav\" data-kid=\"1-1-2\" data-name=\"primary desktop navigation\">\n            <a data-kid=\"1-1-2-1\" data-name=\"navigate to Explore Companies\" href=\"/companies\">\n                Explore Companies\n            </a>\n            <a data-kid=\"1-1-2-2\" data-name=\"navigate to How It Works section\" href=\"#how-it-works\">\n                How It Works\n            </a>\n            <a data-kid=\"1-1-2-3\" data-name=\"navigate to Community Guidelines\" href=\"/community-guidelines\">\n                Community Guidelines\n            </a>\n        </nav>\n        <a class=\"wt-header-cta\" data-kid=\"1-1-3\" data-name=\"header call-to-action button\" href=\"/write-review\">\n            Write a Review\n        </a>\n        <details class=\"wt-mobile-menu\" data-kid=\"1-1-4\" data-name=\"mobile menu disclosure\">\n            <summary aria-label=\"Open navigation menu\" data-kid=\"1-1-4-1\" data-name=\"mobile menu toggle button\">\n                Menu\n            </summary>\n            <nav aria-label=\"Mobile navigation\" class=\"wt-mobile-links\" data-kid=\"1-1-4-2\" data-name=\"mobile dropdown navigation\">\n                <a data-kid=\"1-1-4-2-1\" data-name=\"mobile link to Explore Companies\" href=\"/companies\">\n                    Explore Companies\n                </a>\n                <a data-kid=\"1-1-4-2-2\" data-name=\"mobile link to How It Works\" href=\"#how-it-works\">\n                    How It Works\n                </a>\n                <a data-kid=\"1-1-4-2-3\" data-name=\"mobile link to Community Guidelines\" href=\"/community-guidelines\">\n                    Community Guidelines\n                </a>\n                <a data-kid=\"1-1-4-2-4\" data-name=\"mobile link to Write a Review\" href=\"/write-review\">\n                    Write a Review\n                </a>\n            </nav>\n        </details>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main page content\">\n        <section aria-labelledby=\"hero-title\" class=\"wt-shell wt-hero\" data-kid=\"1-2-1\" data-name=\"hero section with search and sample\">\n            <div class=\"wt-hero-copy\" data-kid=\"1-2-1-1\" data-name=\"hero copy block\">\n                <h1 data-kid=\"1-2-1-1-1\" data-name=\"hero headline\" id=\"hero-title\">\n                    Know what it's really like to work there.\n                </h1>\n                <p data-kid=\"1-2-1-1-2\" data-name=\"hero supporting description\">\n                    Honest workplace experiences from people who have been there. Research Nigerian tech companies before you make your next career move.\n                </p>\n            </div>\n            <form action=\"/companies\" class=\"wt-search-form\" data-kid=\"1-2-1-2\" data-name=\"company search form\" method=\"get\" role=\"search\">\n                <span aria-hidden=\"true\" class=\"wt-search-icon icon icon-search\" data-kid=\"1-2-1-2-1\" data-name=\"search magnifier icon\">\n                </span>\n                <label data-kid=\"1-2-1-2-2\" data-name=\"visually-hidden search field label\" for=\"company-search\" style=\"position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0\">\n                    Search companies in Nigeria\n                </label>\n                <input autocomplete=\"organization\" data-kid=\"1-2-1-2-3\" data-name=\"company name search input\" id=\"company-search\" name=\"q\" placeholder=\"Search companies in Nigeria...\" type=\"search\"/>\n                <button data-kid=\"1-2-1-2-4\" data-name=\"search submit button\" type=\"submit\">\n                    Search companies\n                </button>\n            </form>\n            <div class=\"wt-hero-actions\" data-kid=\"1-2-1-3\" data-name=\"hero secondary actions row\">\n                <a class=\"wt-secondary-link\" data-kid=\"1-2-1-3-1\" data-name=\"share-your-experience link\" href=\"/write-review\">\n                    Share Your Experience\n                    <span aria-hidden=\"true\" data-kid=\"1-2-1-3-1-1\" data-name=\"external-link arrow\">\n                        ↗\n                    </span>\n                </a>\n                <span class=\"wt-trust-note\" data-kid=\"1-2-1-3-2\" data-name=\"anonymity trust note\">\n                    <span aria-hidden=\"true\" class=\"icon icon-eye-off\" data-kid=\"1-2-1-3-2-1\" data-name=\"eye-off privacy icon\">\n                    </span>\n                    Read anonymously. Share without an account.\n                </span>\n            </div>\n            <article aria-label=\"Fictional company review preview\" class=\"wt-example\" data-kid=\"1-2-1-4\" data-name=\"sample company review preview card\">\n                <div class=\"wt-example-head\" data-kid=\"1-2-1-4-1\" data-name=\"sample card header\">\n                    <div data-kid=\"1-2-1-4-1-1\" data-name=\"sample company info wrapper\">\n                        <div class=\"wt-company-title\" data-kid=\"1-2-1-4-1-1-1\" data-name=\"sample company title row\">\n                            <h2 data-kid=\"1-2-1-4-1-1-1-1\" data-name=\"sample company name heading\">\n                                KoraStack Studio\n                            </h2>\n                            <span class=\"wt-demo-label\" data-kid=\"1-2-1-4-1-1-1-2\" data-name=\"disclaimer label for sample\">\n                                Fictional example · Sample preview — not published feedback\n                            </span>\n                        </div>\n                        <div class=\"wt-company-meta\" data-kid=\"1-2-1-4-1-1-2\" data-name=\"sample company industry and location\">\n                            Software development · Lagos, Nigeria\n                        </div>\n                    </div>\n                    <div aria-label=\"Average rating 4.2 out of 5 from 6 sample reviews\" class=\"wt-rating\" data-kid=\"1-2-1-4-1-2\" data-name=\"sample average rating display\">\n                        <span aria-hidden=\"true\" class=\"icon icon-star\" data-kid=\"1-2-1-4-1-2-1\" data-name=\"star rating icon\">\n                        </span>\n                        <strong data-kid=\"1-2-1-4-1-2-2\" data-name=\"sample numeric rating value\">\n                            4.2\n                        </strong>\n                        <span data-kid=\"1-2-1-4-1-2-3\" data-name=\"sample review count\">\n                            6 sample reviews\n                        </span>\n                    </div>\n                </div>\n                <div class=\"wt-example-body\" data-kid=\"1-2-1-4-2\" data-name=\"sample review body\">\n                    <div class=\"wt-review-kicker\" data-kid=\"1-2-1-4-2-1\" data-name=\"sample experience kicker label\">\n                        A sample experience\n                    </div>\n                    <div class=\"wt-example-review\" data-kid=\"1-2-1-4-2-2\" data-name=\"sample review content\">\n                        <h3 data-kid=\"1-2-1-4-2-2-1\" data-name=\"sample review headline\">\n                            Room to learn, with a few trade-offs\n                        </h3>\n                        <p data-kid=\"1-2-1-4-2-2-2\" data-name=\"sample review quote\">\n                            “I had space to take ownership of meaningful product work, and teammates were generous with context. Priorities could shift quickly, so planning a week ahead took some flexibility.”\n                        </p>\n                        <div class=\"wt-example-pros\" data-kid=\"1-2-1-4-2-2-3\" data-name=\"sample pros and cons summary\">\n                            <b data-kid=\"1-2-1-4-2-2-3-1\" data-name=\"pros label with green color\">\n                                Pros\n                            </b>\n                            Supportive peers · Broad ownership\n                            <b data-kid=\"1-2-1-4-2-2-3-2\" data-name=\"cons label with muted color\" style=\"color:#69655d\">\n                                Cons\n                            </b>\n                            Changing priorities\n                        </div>\n                    </div>\n                </div>\n            </article>\n            <p class=\"wt-demo-disclaimer\" data-kid=\"1-2-1-5\" data-name=\"disclaimer text about fictional data\">\n                All company names and review details on this page are fictional examples, created to show how Worktruth could look.\n            </p>\n        </section>\n        <section aria-labelledby=\"value-title\" class=\"wt-shell wt-section wt-values\" data-kid=\"1-2-2\" data-name=\"core values section\">\n            <h2 class=\"wt-section-heading\" data-kid=\"1-2-2-1\" data-name=\"values section heading\" id=\"value-title\">\n                Make career decisions with more context.\n            </h2>\n            <div class=\"wt-value-grid\" data-kid=\"1-2-2-2\" data-name=\"core values grid\">\n                <article class=\"wt-value\" data-kid=\"1-2-2-2-1\" data-name=\"value card: Real Workplace Experiences\">\n                    <span aria-hidden=\"true\" class=\"icon icon-messages-square\" data-kid=\"1-2-2-2-1-1\" data-name=\"speech bubbles/experience icon\">\n                    </span>\n                    <h3 data-kid=\"1-2-2-2-1-2\" data-name=\"value card heading: Real Workplace Experiences\">\n                        Real Workplace Experiences\n                    </h3>\n                    <p data-kid=\"1-2-2-2-1-3\" data-name=\"value card description: first-hand perspectives\">\n                        Learn from current and former employees with first-hand perspectives on work and culture.\n                    </p>\n                </article>\n                <article class=\"wt-value\" data-kid=\"1-2-2-2-2\" data-name=\"value card: Anonymous by Design\">\n                    <span aria-hidden=\"true\" class=\"icon icon-user-round\" data-kid=\"1-2-2-2-2-1\" data-name=\"user/silhouette icon\">\n                    </span>\n                    <h3 data-kid=\"1-2-2-2-2-2\" data-name=\"value card heading: Anonymous by Design\">\n                        Anonymous by Design\n                    </h3>\n                    <p data-kid=\"1-2-2-2-2-3\" data-name=\"value card description: no account needed\">\n                        Share without creating an account or displaying your identity publicly.\n                    </p>\n                </article>\n                <article class=\"wt-value\" data-kid=\"1-2-2-2-3\" data-name=\"value card: Human-Reviewed Feedback\">\n                    <span aria-hidden=\"true\" class=\"icon icon-clipboard-check\" data-kid=\"1-2-2-2-3-1\" data-name=\"clipboard with checkmark icon\">\n                    </span>\n                    <h3 data-kid=\"1-2-2-2-3-2\" data-name=\"value card heading: Human-Reviewed Feedback\">\n                        Human-Reviewed Feedback\n                    </h3>\n                    <p data-kid=\"1-2-2-2-3-3\" data-name=\"value card description: human moderation\">\n                        Every review is moderated by a person before it can appear on Worktruth.\n                    </p>\n                </article>\n            </div>\n        </section>\n        <section aria-labelledby=\"how-title\" class=\"wt-how\" data-kid=\"1-2-3\" data-name=\"how-it-works section\" id=\"how-it-works\">\n            <div class=\"wt-shell\" data-kid=\"1-2-3-1\" data-name=\"how-it-works content shell\">\n                <h2 class=\"wt-section-heading\" data-kid=\"1-2-3-1-1\" data-name=\"how-it-works heading\" id=\"how-title\">\n                    How it works\n                </h2>\n                <div class=\"wt-steps\" data-kid=\"1-2-3-1-2\" data-name=\"process steps grid\">\n                    <article class=\"wt-step\" data-kid=\"1-2-3-1-2-1\" data-name=\"step 1 card: Find a company\">\n                        <span class=\"wt-step-num\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"step number 01\">\n                            01\n                        </span>\n                        <h3 data-kid=\"1-2-3-1-2-1-2\" data-name=\"step 1 title: Find a company\">\n                            Find a company.\n                        </h3>\n                        <p data-kid=\"1-2-3-1-2-1-3\" data-name=\"step 1 description\">\n                            Search the Nigerian tech companies you’re considering, or browse the directory.\n                        </p>\n                    </article>\n                    <article class=\"wt-step\" data-kid=\"1-2-3-1-2-2\" data-name=\"step 2 card: Read employee experiences\">\n                        <span class=\"wt-step-num\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"step number 02\">\n                            02\n                        </span>\n                        <h3 data-kid=\"1-2-3-1-2-2-2\" data-name=\"step 2 title: Read employee experiences\">\n                            Read employee experiences.\n                        </h3>\n                        <p data-kid=\"1-2-3-1-2-2-3\" data-name=\"step 2 description\">\n                            Understand the mix of perspectives behind the workplace rating.\n                        </p>\n                    </article>\n                    <article class=\"wt-step\" data-kid=\"1-2-3-1-2-3\" data-name=\"step 3 card: Share your experience\">\n                        <span class=\"wt-step-num\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"step number 03\">\n                            03\n                        </span>\n                        <h3 data-kid=\"1-2-3-1-2-3-2\" data-name=\"step 3 title: Share anonymously\">\n                            Share your own experience anonymously.\n                        </h3>\n                        <p data-kid=\"1-2-3-1-2-3-3\" data-name=\"step 3 description\">\n                            Submit without an account. Reviews are checked by a human before publication.\n                        </p>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"discovery-title\" class=\"wt-shell wt-discovery\" data-kid=\"1-2-4\" data-name=\"company discovery section\">\n            <div class=\"wt-discovery-head\" data-kid=\"1-2-4-1\" data-name=\"discovery section header row\">\n                <div data-kid=\"1-2-4-1-1\" data-name=\"left column: heading and note\">\n                    <h2 class=\"wt-section-heading\" data-kid=\"1-2-4-1-1-1\" data-name=\"discovery section heading\" id=\"discovery-title\">\n                        Get to know the companies behind the job titles.\n                    </h2>\n                    <p class=\"wt-sample-note\" data-kid=\"1-2-4-1-1-2\" data-name=\"sample data disclaimer note\">\n                        Fictional sample companies and illustrative review data — not real employer feedback.\n                    </p>\n                </div>\n                <a class=\"wt-text-link\" data-kid=\"1-2-4-1-2\" data-name=\"explore companies text link\" href=\"/companies\">\n                    Explore Companies\n                    <span aria-hidden=\"true\" data-kid=\"1-2-4-1-2-1\" data-name=\"external-link arrow\">\n                        ↗\n                    </span>\n                </a>\n            </div>\n            <div class=\"wt-company-grid\" data-kid=\"1-2-4-2\" data-name=\"company directory grid\">\n                <a class=\"wt-company-card\" data-kid=\"1-2-4-2-1\" data-name=\"company card: KoraStack Studio\" href=\"/companies?q=KoraStack+Studio\">\n                    <h3 data-kid=\"1-2-4-2-1-1\" data-name=\"company name heading: KoraStack Studio\">\n                        KoraStack Studio\n                    </h3>\n                    <p class=\"wt-company-meta\" data-kid=\"1-2-4-2-1-2\" data-name=\"company industry and location: KoraStack\">\n                        Software development · Lagos\n                    </p>\n                    <span class=\"wt-company-score\" data-kid=\"1-2-4-2-1-3\" data-name=\"company rating row: KoraStack\">\n                        <span aria-hidden=\"true\" class=\"icon icon-star\" data-kid=\"1-2-4-2-1-3-1\" data-name=\"star icon on company card\">\n                        </span>\n                        <strong data-kid=\"1-2-4-2-1-3-2\" data-name=\"numeric rating value: 4.2\">\n                            4.2\n                        </strong>\n                        <span data-kid=\"1-2-4-2-1-3-3\" data-name=\"review count: 6 sample\">\n                            · 6 sample reviews\n                        </span>\n                    </span>\n                    <span class=\"wt-summary\" data-kid=\"1-2-4-2-1-4\" data-name=\"one-line summary: KoraStack\">\n                        Supportive peers, changing priorities\n                    </span>\n                </a>\n                <a class=\"wt-company-card\" data-kid=\"1-2-4-2-2\" data-name=\"company card: Northstar Stack Works\" href=\"/companies?q=Northstar+Stack+Works\">\n                    <h3 data-kid=\"1-2-4-2-2-1\" data-name=\"company name heading: Northstar Stack Works\">\n                        Northstar Stack Works\n                    </h3>\n                    <p class=\"wt-company-meta\" data-kid=\"1-2-4-2-2-2\" data-name=\"company industry and location: Northstar\">\n                        Cloud tools · Abuja\n                    </p>\n                    <span class=\"wt-company-score\" data-kid=\"1-2-4-2-2-3\" data-name=\"company rating row: Northstar\">\n                        <span aria-hidden=\"true\" class=\"icon icon-star\" data-kid=\"1-2-4-2-2-3-1\" data-name=\"star icon on company card\">\n                        </span>\n                        <strong data-kid=\"1-2-4-2-2-3-2\" data-name=\"numeric rating value: 3.8\">\n                            3.8\n                        </strong>\n                        <span data-kid=\"1-2-4-2-2-3-3\" data-name=\"review count: 4 sample\">\n                            · 4 sample reviews\n                        </span>\n                    </span>\n                    <span class=\"wt-summary\" data-kid=\"1-2-4-2-2-4\" data-name=\"one-line summary: Northstar\">\n                        Strong learning, uneven workload\n                    </span>\n                </a>\n                <a class=\"wt-company-card\" data-kid=\"1-2-4-2-3\" data-name=\"company card: Blue Okra Digital\" href=\"/companies?q=Blue+Okra+Digital\">\n                    <h3 data-kid=\"1-2-4-2-3-1\" data-name=\"company name heading: Blue Okra Digital\">\n                        Blue Okra Digital\n                    </h3>\n                    <p class=\"wt-company-meta\" data-kid=\"1-2-4-2-3-2\" data-name=\"company industry and location: Blue Okra\">\n                        Product design · Lagos\n                    </p>\n                    <span class=\"wt-company-score\" data-kid=\"1-2-4-2-3-3\" data-name=\"company rating row: Blue Okra\">\n                        <span aria-hidden=\"true\" class=\"icon icon-star\" data-kid=\"1-2-4-2-3-3-1\" data-name=\"star icon on company card\">\n                        </span>\n                        <strong data-kid=\"1-2-4-2-3-3-2\" data-name=\"numeric rating value: 4.5\">\n                            4.5\n                        </strong>\n                        <span data-kid=\"1-2-4-2-3-3-3\" data-name=\"review count: 3 sample\">\n                            · 3 sample reviews\n                        </span>\n                    </span>\n                    <span class=\"wt-summary\" data-kid=\"1-2-4-2-3-4\" data-name=\"one-line summary: Blue Okra\">\n                        Thoughtful craft and team feedback\n                    </span>\n                </a>\n                <a class=\"wt-company-card\" data-kid=\"1-2-4-2-4\" data-name=\"company card: Lantern Pay Lab\" href=\"/companies?q=Lantern+Pay+Lab\">\n                    <h3 data-kid=\"1-2-4-2-4-1\" data-name=\"company name heading: Lantern Pay Lab\">\n                        Lantern Pay Lab\n                    </h3>\n                    <p class=\"wt-company-meta\" data-kid=\"1-2-4-2-4-2\" data-name=\"company industry and location: Lantern Pay\">\n                        Financial technology · Lagos\n                    </p>\n                    <span class=\"wt-company-score\" data-kid=\"1-2-4-2-4-3\" data-name=\"company rating row: Lantern Pay\">\n                        <span aria-hidden=\"true\" class=\"icon icon-star\" data-kid=\"1-2-4-2-4-3-1\" data-name=\"star icon on company card\">\n                        </span>\n                        <strong data-kid=\"1-2-4-2-4-3-2\" data-name=\"numeric rating value: 3.6\">\n                            3.6\n                        </strong>\n                        <span data-kid=\"1-2-4-2-4-3-3\" data-name=\"review count: 5 sample\">\n                            · 5 sample reviews\n                        </span>\n                    </span>\n                    <span class=\"wt-summary\" data-kid=\"1-2-4-2-4-4\" data-name=\"one-line summary: Lantern Pay\">\n                        Purposeful work, fast-moving plans\n                    </span>\n                </a>\n                <a class=\"wt-company-card\" data-kid=\"1-2-4-2-5\" data-name=\"company card: EchoPalm Product Co\" href=\"/companies?q=EchoPalm+Product+Co\">\n                    <h3 data-kid=\"1-2-4-2-5-1\" data-name=\"company name heading: EchoPalm Product Co\">\n                        EchoPalm Product Co.\n                    </h3>\n                    <p class=\"wt-company-meta\" data-kid=\"1-2-4-2-5-2\" data-name=\"company industry and location: EchoPalm\">\n                        Mobile products · Port Harcourt\n                    </p>\n                    <span class=\"wt-company-score\" data-kid=\"1-2-4-2-5-3\" data-name=\"company rating row: EchoPalm\">\n                        <span aria-hidden=\"true\" class=\"icon icon-star\" data-kid=\"1-2-4-2-5-3-1\" data-name=\"star icon on company card\">\n                        </span>\n                        <strong data-kid=\"1-2-4-2-5-3-2\" data-name=\"numeric rating value: 4.0\">\n                            4.0\n                        </strong>\n                        <span data-kid=\"1-2-4-2-5-3-3\" data-name=\"review count: 2 sample\">\n                            · 2 sample reviews\n                        </span>\n                    </span>\n                    <span class=\"wt-summary\" data-kid=\"1-2-4-2-5-4\" data-name=\"one-line summary: EchoPalm\">\n                        Close collaboration, room to grow\n                    </span>\n                </a>\n                <a class=\"wt-company-card\" data-kid=\"1-2-4-2-6\" data-name=\"company card: Mossline Prototype Studio\" href=\"/companies?q=Mossline+Prototype+Studio\">\n                    <h3 data-kid=\"1-2-4-2-6-1\" data-name=\"company name heading: Mossline Prototype Studio\">\n                        Mossline Prototype Studio\n                    </h3>\n                    <p class=\"wt-company-meta\" data-kid=\"1-2-4-2-6-2\" data-name=\"company industry and location: Mossline\">\n                        Software tools · Ibadan\n                    </p>\n                    <span class=\"wt-no-reviews\" data-kid=\"1-2-4-2-6-3\" data-name=\"no-reviews state label\">\n                        No sample reviews\n                    </span>\n                    <span class=\"wt-summary\" data-kid=\"1-2-4-2-6-4\" data-name=\"invitation to be first reviewer\">\n                        Be the first to share an experience\n                    </span>\n                </a>\n            </div>\n        </section>\n        <section aria-labelledby=\"reviews-title\" class=\"wt-review-section\" data-kid=\"1-2-5\" data-name=\"deep-dive review section\">\n            <div class=\"wt-shell\" data-kid=\"1-2-5-1\" data-name=\"review section content shell\">\n                <h2 class=\"wt-section-heading\" data-kid=\"1-2-5-1-1\" data-name=\"review section heading\" id=\"reviews-title\">\n                    More than a rating. Real workplace context.\n                </h2>\n                <p class=\"wt-section-intro\" data-kid=\"1-2-5-1-2\" data-name=\"review section intro text\">\n                    A score is a starting point. The details help explain what work can feel like day to day.\n                </p>\n                <div class=\"wt-review-grid\" data-kid=\"1-2-5-1-3\" data-name=\"reviews two-column grid\">\n                    <article class=\"wt-review-card\" data-kid=\"1-2-5-1-3-1\" data-name=\"review card: KoraStack Studio\">\n                        <div class=\"wt-demo-label\" data-kid=\"1-2-5-1-3-1-1\" data-name=\"fictional example label\">\n                            Fictional review example · not published feedback\n                        </div>\n                        <h3 data-kid=\"1-2-5-1-3-1-2\" data-name=\"review company heading\">\n                            KoraStack Studio\n                        </h3>\n                        <div class=\"wt-review-meta\" data-kid=\"1-2-5-1-3-1-3\" data-name=\"reviewer meta: role and employment status\">\n                            <span data-kid=\"1-2-5-1-3-1-3-1\" data-name=\"reviewer role: Product designer\">\n                                Product designer\n                            </span>\n                            <span class=\"dot\" data-kid=\"1-2-5-1-3-1-3-2\" data-name=\"meta separator dot\">\n                            </span>\n                            <span data-kid=\"1-2-5-1-3-1-3-3\" data-name=\"employment status: Former employee\">\n                                Former employee\n                            </span>\n                        </div>\n                        <div class=\"wt-review-rating\" data-kid=\"1-2-5-1-3-1-4\" data-name=\"review rating row: KoraStack\">\n                            <span aria-hidden=\"true\" class=\"icon icon-star\" data-kid=\"1-2-5-1-3-1-4-1\" data-name=\"star icon\">\n                            </span>\n                            <strong data-kid=\"1-2-5-1-3-1-4-2\" data-name=\"review rating score: 4.0/5\">\n                                4.0 / 5\n                            </strong>\n                            <span class=\"wt-review-date\" data-kid=\"1-2-5-1-3-1-4-3\" data-name=\"review sample date\">\n                                · October 2025 sample\n                            </span>\n                        </div>\n                        <div class=\"wt-pros-cons\" data-kid=\"1-2-5-1-3-1-5\" data-name=\"pros and cons two-column block\">\n                            <div data-kid=\"1-2-5-1-3-1-5-1\" data-name=\"pros column\">\n                                <h4 data-kid=\"1-2-5-1-3-1-5-1-1\" data-name=\"pros heading\">\n                                    Pros\n                                </h4>\n                                <p data-kid=\"1-2-5-1-3-1-5-1-2\" data-name=\"pros text: design collaboration\">\n                                    Design had a seat at planning, and teammates were generous about sharing what they knew.\n                                </p>\n                            </div>\n                            <div class=\"wt-cons\" data-kid=\"1-2-5-1-3-1-5-2\" data-name=\"cons column\">\n                                <h4 data-kid=\"1-2-5-1-3-1-5-2-1\" data-name=\"cons heading\">\n                                    Cons\n                                </h4>\n                                <p data-kid=\"1-2-5-1-3-1-5-2-2\" data-name=\"cons text: shifting priorities\">\n                                    Project priorities sometimes changed late, which made longer-term planning harder.\n                                </p>\n                            </div>\n                        </div>\n                    </article>\n                    <article class=\"wt-review-card\" data-kid=\"1-2-5-1-3-2\" data-name=\"review card: Northstar Stack Works\">\n                        <div class=\"wt-demo-label\" data-kid=\"1-2-5-1-3-2-1\" data-name=\"fictional example label\">\n                            Fictional review example · not published feedback\n                        </div>\n                        <h3 data-kid=\"1-2-5-1-3-2-2\" data-name=\"review company heading: Northstar\">\n                            Northstar Stack Works\n                        </h3>\n                        <div class=\"wt-review-meta\" data-kid=\"1-2-5-1-3-2-3\" data-name=\"reviewer meta: role and status\">\n                            <span data-kid=\"1-2-5-1-3-2-3-1\" data-name=\"reviewer role: Backend engineer\">\n                                Backend engineer\n                            </span>\n                            <span class=\"dot\" data-kid=\"1-2-5-1-3-2-3-2\" data-name=\"meta separator dot\">\n                            </span>\n                            <span data-kid=\"1-2-5-1-3-2-3-3\" data-name=\"employment status: Current employee\">\n                                Current employee\n                            </span>\n                        </div>\n                        <div class=\"wt-review-rating\" data-kid=\"1-2-5-1-3-2-4\" data-name=\"review rating row: Northstar\">\n                            <span aria-hidden=\"true\" class=\"icon icon-star\" data-kid=\"1-2-5-1-3-2-4-1\" data-name=\"star icon\">\n                            </span>\n                            <strong data-kid=\"1-2-5-1-3-2-4-2\" data-name=\"review rating score: 3.0/5\">\n                                3.0 / 5\n                            </strong>\n                            <span class=\"wt-review-date\" data-kid=\"1-2-5-1-3-2-4-3\" data-name=\"review sample date\">\n                                · September 2025 sample\n                            </span>\n                        </div>\n                        <div class=\"wt-pros-cons\" data-kid=\"1-2-5-1-3-2-5\" data-name=\"pros and cons two-column block\">\n                            <div data-kid=\"1-2-5-1-3-2-5-1\" data-name=\"pros column\">\n                                <h4 data-kid=\"1-2-5-1-3-2-5-1-1\" data-name=\"pros heading\">\n                                    Pros\n                                </h4>\n                                <p data-kid=\"1-2-5-1-3-2-5-1-2\" data-name=\"pros text: learning opportunities\">\n                                    I’ve had useful chances to learn unfamiliar systems and contribute to technical decisions.\n                                </p>\n                            </div>\n                            <div class=\"wt-cons\" data-kid=\"1-2-5-1-3-2-5-2\" data-name=\"cons column\">\n                                <h4 data-kid=\"1-2-5-1-3-2-5-2-1\" data-name=\"cons heading\">\n                                    Cons\n                                </h4>\n                                <p data-kid=\"1-2-5-1-3-2-5-2-2\" data-name=\"cons text: uneven workload\">\n                                    Workload can be uneven, and expectations are not always clear across teams.\n                                </p>\n                            </div>\n                        </div>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"privacy-title\" class=\"wt-shell wt-privacy\" data-kid=\"1-2-6\" data-name=\"privacy and safety section\">\n            <div class=\"wt-privacy-layout\" data-kid=\"1-2-6-1\" data-name=\"privacy two-column layout\">\n                <h2 class=\"wt-section-heading\" data-kid=\"1-2-6-1-1\" data-name=\"privacy section heading\" id=\"privacy-title\">\n                    Your experience. Shared on your terms.\n                </h2>\n                <div class=\"wt-privacy-copy\" data-kid=\"1-2-6-1-2\" data-name=\"privacy copy block\">\n                    <p data-kid=\"1-2-6-1-2-1\" data-name=\"privacy text: no account needed\">\n                        You don’t need an account to submit a review. If a review is published, it won’t display your identity publicly.\n                    </p>\n                    <p data-kid=\"1-2-6-1-2-2\" data-name=\"privacy text: moderation and anonymity caveats\">\n                        Each submission is manually moderated before publication. Moderation helps us apply our community guidelines; it does not mean every statement has been independently verified. We can’t promise absolute anonymity, so please avoid including details that could identify you in your review.\n                    </p>\n                    <div class=\"wt-privacy-links\" data-kid=\"1-2-6-1-2-3\" data-name=\"privacy policy links row\">\n                        <a data-kid=\"1-2-6-1-2-3-1\" data-name=\"link to Community Guidelines\" href=\"/community-guidelines\">\n                            Community Guidelines ↗\n                        </a>\n                        <a data-kid=\"1-2-6-1-2-3-2\" data-name=\"link to Privacy Policy\" href=\"/privacy\">\n                            Privacy ↗\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"final-title\" class=\"wt-cta-band\" data-kid=\"1-2-7\" data-name=\"call-to-action band\">\n            <div class=\"wt-shell wt-cta-inner\" data-kid=\"1-2-7-1\" data-name=\"CTA inner layout\">\n                <div class=\"wt-cta-copy\" data-kid=\"1-2-7-1-1\" data-name=\"CTA copy block\">\n                    <h2 data-kid=\"1-2-7-1-1-1\" data-name=\"CTA headline\" id=\"final-title\">\n                        Help someone make a better career decision.\n                    </h2>\n                    <p data-kid=\"1-2-7-1-1-2\" data-name=\"CTA supporting copy\">\n                        Your workplace experience could give someone the context they need before accepting their next offer.\n                    </p>\n                </div>\n                <div class=\"wt-cta-actions\" data-kid=\"1-2-7-1-2\" data-name=\"CTA actions row\">\n                    <a class=\"wt-cta-primary\" data-kid=\"1-2-7-1-2-1\" data-name=\"primary CTA button: Write anonymous review\" href=\"/write-review\">\n                        Write an Anonymous Review\n                    </a>\n                    <a class=\"wt-cta-secondary\" data-kid=\"1-2-7-1-2-2\" data-name=\"secondary CTA link: Find a Company\" href=\"/companies\">\n                        Find a Company ↗\n                    </a>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"wt-shell wt-footer\" data-kid=\"1-3\" data-name=\"site footer\">\n        <div class=\"wt-footer-top\" data-kid=\"1-3-1\" data-name=\"footer top row: brand and links\">\n            <a aria-label=\"Worktruth home\" class=\"wt-brand\" data-kid=\"1-3-1-1\" data-name=\"footer brand logo link\" href=\"/\">\n                <span aria-hidden=\"true\" class=\"wt-mark\" data-kid=\"1-3-1-1-1\" data-name=\"footer brand monogram\">\n                    w\n                </span>\n                <span data-kid=\"1-3-1-1-2\" data-name=\"footer brand name\">\n                    Worktruth\n                </span>\n            </a>\n            <nav aria-label=\"Footer\" class=\"wt-footer-links\" data-kid=\"1-3-1-2\" data-name=\"footer navigation links\">\n                <a data-kid=\"1-3-1-2-1\" data-name=\"footer link: Explore Companies\" href=\"/companies\">\n                    Explore Companies\n                </a>\n                <a data-kid=\"1-3-1-2-2\" data-name=\"footer link: Write a Review\" href=\"/write-review\">\n                    Write a Review\n                </a>\n                <a data-kid=\"1-3-1-2-3\" data-name=\"footer link: Community Guidelines\" href=\"/community-guidelines\">\n                    Community Guidelines\n                </a>\n                <a data-kid=\"1-3-1-2-4\" data-name=\"footer link: Privacy Policy\" href=\"/privacy\">\n                    Privacy Policy\n                </a>\n                <a data-kid=\"1-3-1-2-5\" data-name=\"footer link: Terms of Service\" href=\"/terms\">\n                    Terms of Service\n                </a>\n                <a data-kid=\"1-3-1-2-6\" data-name=\"footer link: Contact (email)\" href=\"mailto:hello@worktruth.example\">\n                    Contact\n                </a>\n            </nav>\n        </div>\n        <div class=\"wt-footer-bottom\" data-kid=\"1-3-2\" data-name=\"footer bottom row: copyright and disclaimer\">\n            <p data-kid=\"1-3-2-1\" data-name=\"copyright notice\">\n                © 2025 Worktruth\n            </p>\n            <p data-kid=\"1-3-2-2\" data-name=\"demo content disclaimer\">\n                Demo content is fictional and shown for illustration only.\n            </p>\n        </div>\n    </footer>\n</div>\n",
