bbd2bf]\" data-kid=\"1-3-1-1-3-2-3\" data-name=\"footer Contact link\" href=\"/contact\">\n                            Contact\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-8 flex flex-wrap justify-between gap-3 border-t border-[#3b463e] pt-5 text-[12px] text-[#aeb8ae]\" data-kid=\"1-3-1-2\" data-name=\"footer bottom bar\">\n                <span data-kid=\"1-3-1-2-1\" data-name=\"footer copyright text\">\n                    © 2026 Worktruth. Sample content is fictional.\n                </span>\n                <span data-kid=\"1-3-1-2-2\" data-name=\"footer tagline text\">\n                    For more thoughtful career decisions.\n                </span>\n            </div>\n        </div>\n    </footer>\n</div>\n",
